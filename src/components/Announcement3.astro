---
const { message = "📢 GROW268 สล็อตเว็บตรงเว็บแท้ VIP แตกง่าย ปลอดภัย โบนัสจ่ายจริง ฝากถอนอัตโนมัติ 24 ชม. อัปเดตทางเข้าล่าสุดที่ www.grow268-brand.com" } = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-amber-500/30 bg-gradient-to-r from-amber-900/30 to-[#0a0806] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(234,179,8,0.12)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-amber-500 bg-black shadow-[0_0_15px_rgba(234,179,8,0.6)]">
      <span class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-amber-500/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-amber-300">
        <span class="drop-shadow-[0_0_5px_rgba(251,191,36,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(251,191,36,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
