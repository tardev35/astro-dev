---
const { message = "🎰 CASHOT123 เว็บออนไลน์คาสิโน เว็บตรงครบวงจร รวมสล็อต คาสิโนสด กีฬา หวย ไว้ในที่เดียว ฝากถอนอัตโนมัติ 24 ชม. ปลอดภัย SSL/TLS 256-bit www.cashot123-brand.com" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#dc2626]/40 bg-[#14040a] shadow-[0_0_15px_rgba(220,38,38,0.15)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ef4444] to-[#991b1b]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#dc2626]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#dc2626] to-[#991b1b] py-2.5">
        <span class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#14040a] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#14040a] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-amber-400">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_5px_rgba(245,158,11,0.8)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_5px_rgba(245,158,11,0.8)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
