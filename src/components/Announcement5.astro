---
const { message = "🎰 KINGHENG168 สล็อตทำเงินง่ายรายได้ดี แตกง่ายจ่ายจริง ฝากถอนไวด้วยระบบออโต้ AI อัจฉริยะ เชื่อมต่อ API แท้ ไม่ล็อคยูสเซอร์ จ่ายเต็ม 100% ตลอด 24 ชม. kingheng168v.com" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-amber-500/45 bg-[#14040a] shadow-[0_0_15px_rgba(245,158,11,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#fbbf24] to-[#b45309]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f59e0b]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#fbbf24] to-[#b45309] py-2.5">
        <span class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#14040a] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#14040a] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-amber-400">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_5px_rgba(245,158,11,0.8)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f59e0b] shadow-[0_0_5px_rgba(245,158,11,0.8)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
