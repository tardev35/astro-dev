---
const { message = "🎰 PGZEED168 สล็อตเกมยอดนิยม โบนัสเข้าง่าย ฝากถอนออโต้ API แท้ไม่ล็อคยูสเซอร์ จ่ายเต็ม 100%!" } = Astro.props;
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-green-400/40 bg-gradient-to-b from-[#061409] via-[#02060f] to-[#061409] p-1 shadow-[0_5px_20px_rgba(34,197,94,0.18),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-green-400/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-lime-400/12 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-lime-400/40 bg-gradient-to-b from-lime-300 via-lime-400 to-green-500 px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#04120a] shadow-[0_0_6px_rgba(4,18,10,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#04120a] uppercase md:text-sm">🎰 PGZEED168</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-lime-300/90">
        <span>{message}</span>
        <span class="text-green-400/70">✨</span>
        <span>{message}</span>
        <span class="text-green-400/70">✨</span>
        <span>{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-lime-400/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
