---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-lime-400/35 bg-[#04120a]/80 p-8 text-left text-base leading-relaxed text-lime-50/85 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-lime-300/60 hover:shadow-[0_15px_40px_rgba(163,230,53,0.25)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-lime-400/15 blur-[60px] transition-all duration-500 group-hover:bg-lime-300/25"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-green-500/12 blur-[60px] transition-all duration-500 group-hover:bg-green-400/20"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-lime-400/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-lime-200 via-lime-400 to-green-600 shadow-[0_0_15px_rgba(163,230,53,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-lime-100 to-lime-300 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
