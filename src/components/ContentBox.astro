---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-red-500/35 bg-[#14040a]/80 p-8 text-left text-base leading-relaxed text-red-50/80 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-red-400/60 hover:shadow-[0_15px_40px_rgba(220,38,38,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-red-600/15 blur-[60px] transition-all duration-500 group-hover:bg-red-500/25"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-yellow-500/8 blur-[60px] transition-all duration-500 group-hover:bg-yellow-500/15"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-red-500/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-amber-300 to-amber-600 shadow-[0_0_15px_rgba(245,158,11,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-red-100 to-red-300 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
