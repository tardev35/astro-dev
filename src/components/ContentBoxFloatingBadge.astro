---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative w-full max-w-[1400px] rounded-2xl border-2 border-blue-500/40 bg-gradient-to-b from-[#0b1633] to-[#030a1a] p-8 pt-28 text-left text-base leading-relaxed text-blue-50/90 shadow-[0_10px_40px_rgba(0,0,0,0.5)]">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-orange-500/50 bg-[#030a1a] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(249,115,22,0.3)] sm:px-8">
          <HeadingTag class={`bg-gradient-to-r from-blue-200 via-blue-300 to-orange-400 bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            ✦ {title} ✦
          </HeadingTag>
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
