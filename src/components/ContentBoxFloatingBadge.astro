---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-lg sm:text-2xl md:text-3xl" : "text-base sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative w-full max-w-[1400px] rounded-2xl border-2 border-amber-400/40 bg-gradient-to-b from-[#062b16] to-[#04170d] p-8 pt-36 text-left text-base leading-relaxed text-emerald-50/85 shadow-[0_10px_40px_rgba(0,0,0,0.5)] sm:pt-28">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-amber-400/50 bg-[#04170d] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(251,191,36,0.3)] sm:px-8">
          <HeadingTag class={`bg-gradient-to-r from-emerald-200 via-amber-200 to-amber-400 bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent`}>
            {title}
          </HeadingTag>
        </div>
      )
    }

    <slot />
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
