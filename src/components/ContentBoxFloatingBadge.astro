---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl md:text-3xl" : "text-lg md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-[1400px] rounded-2xl border-2 border-amber-500/40 bg-gradient-to-b from-[#141008] to-[#060a14] p-6 shadow-[0_10px_40px_rgba(0,0,0,0.5)] md:p-8 md:pt-28">
    {
      title && (
        <div class="mx-auto mb-6 flex w-full max-w-2xl items-center justify-center gap-2 rounded-lg border-2 border-slate-300/40 bg-[#060a14] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(251,191,36,0.3)] md:absolute md:-top-6 md:left-1/2 md:mx-0 md:mb-0 md:w-[92%] md:-translate-x-1/2 md:px-8">
          <span aria-hidden="true" class="shrink-0 text-amber-400">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-slate-100 via-slate-300 to-amber-400 bg-clip-text ${headingSize} font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-amber-400">
            ✦
          </span>
        </div>
      )
    }

    <div class="text-center text-base leading-relaxed text-slate-200/90 md:text-lg">
      <slot />
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
