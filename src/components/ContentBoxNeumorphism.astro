---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-[1400px] rounded-[25px] bg-[#0b1120] p-8 text-center text-white/90 shadow-[10px_10px_20px_#060a14,-10px_-10px_20px_#141c2e]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class={`bg-gradient-to-r from-slate-100 via-slate-300 to-amber-400 bg-clip-text ${headingSize} font-black text-transparent drop-shadow-md`}>{title}</HeadingTag>
          <div class="mx-auto mt-4 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent" />
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-slate-300/80">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
