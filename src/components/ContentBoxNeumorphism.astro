---
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] bg-[#150406] p-8 text-left text-base leading-relaxed text-red-100/75 shadow-[10px_10px_20px_#070102,-10px_-10px_20px_#25080c]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag class={`bg-gradient-to-r from-red-300 via-red-400 to-amber-400 bg-clip-text ${headingSize} leading-normal font-black text-transparent drop-shadow-md`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
