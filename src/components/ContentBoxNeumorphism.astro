---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] bg-[#07215f] p-8 text-left text-base leading-relaxed text-blue-50/85 shadow-[10px_10px_20px_#040f2c,-10px_-10px_20px_#0e3486]">
    {
      title && (
        <header class="mb-8 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text ${headingSize} leading-normal font-black text-transparent drop-shadow-[0_2px_12px_rgba(251,191,36,0.35)]`}>
            {title}
          </HeadingTag>
          <span class="mx-auto mt-4 block h-[3px] w-28 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent" />
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
