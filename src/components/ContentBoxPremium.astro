---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative w-full max-w-[1400px] overflow-hidden rounded-3xl border border-blue-500/35 bg-[#040b1e]/85 p-8 text-white/90 shadow-[0_10px_30px_rgba(37,99,235,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-blue-400/60 hover:shadow-[0_15px_40px_rgba(37,99,235,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-blue-600/25 blur-[55px] transition-all duration-500 group-hover:bg-blue-500/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-red-600/15 blur-[55px] transition-all duration-500 group-hover:bg-red-500/25"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-yellow-400/60 to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-blue-500/40 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-yellow-300 to-yellow-500 shadow-[0_0_12px_rgba(250,204,21,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-white via-blue-100 to-blue-300 bg-clip-text ${headingSize} font-black tracking-wide text-transparent drop-shadow-sm`}>{title}</HeadingTag>
        </header>
      )
    }
    <div class="relative z-10 text-lg leading-relaxed text-blue-100/85">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
