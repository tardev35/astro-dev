---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative w-full max-w-[1400px] overflow-hidden rounded-3xl border border-amber-500/30 bg-[#0a0806]/80 p-8 text-white/90 shadow-[0_10px_30px_rgba(234,179,8,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-amber-400/60 hover:shadow-[0_15px_40px_rgba(234,179,8,0.25)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-amber-500/20 blur-[50px] transition-all duration-500 group-hover:bg-amber-400/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-yellow-600/10 blur-[50px] transition-all duration-500 group-hover:bg-yellow-500/20"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-800/50 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-amber-300 to-amber-500 shadow-[0_0_10px_rgba(245,158,11,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-amber-200 to-amber-500 bg-clip-text ${headingSize} font-black tracking-widest text-transparent uppercase drop-shadow-sm`}>{title}</HeadingTag>
        </header>
      )
    }
    <div class="relative z-10 text-lg leading-relaxed text-amber-100/90">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
