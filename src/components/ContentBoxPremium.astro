---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative w-full max-w-[1400px] overflow-hidden rounded-3xl border-2 border-amber-400/35 bg-[#1a0505]/85 p-8 text-white/90 shadow-[0_10px_30px_rgba(74,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 hover:shadow-[0_15px_40px_rgba(220,38,38,0.3)] md:p-10">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
    <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-red-600/25 blur-[50px] transition-all duration-500 group-hover:bg-red-500/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-amber-500/15 blur-[50px] transition-all duration-500 group-hover:bg-amber-400/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-500/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-amber-300 via-amber-500 to-red-600 shadow-[0_0_12px_rgba(245,158,11,0.6)]" />
          <HeadingTag class={`bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text ${headingSize} font-black tracking-widest text-transparent uppercase drop-shadow-sm`}>{title}</HeadingTag>
        </header>
      )
    }
    <div class="relative z-10 text-lg leading-relaxed text-amber-50/90">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
