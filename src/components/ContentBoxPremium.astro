---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-green-500/30 bg-[#061409]/80 p-8 text-left text-base leading-relaxed text-lime-50/85 shadow-[0_10px_30px_rgba(34,197,94,0.35)] backdrop-blur-xl transition-all duration-500 hover:border-green-400/60 hover:shadow-[0_15px_40px_rgba(34,197,94,0.5)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-green-600/20 blur-[50px] transition-all duration-500 group-hover:bg-green-500/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-lime-400/12 blur-[50px] transition-all duration-500 group-hover:bg-lime-300/22"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-green-900/60 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-lime-200 to-lime-500 shadow-[0_0_10px_rgba(163,230,53,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-lime-200 to-lime-500 bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
