---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-blue-500/30 bg-[#071433]/85 p-8 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-blue-400/55 hover:shadow-[0_15px_40px_rgba(37,99,235,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 left-1/3 h-44 w-44 rounded-full bg-blue-600/20 blur-[60px]"></div>

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2 border-b border-blue-500/30 pb-6 md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-center text-3xl font-black tracking-wide text-white drop-shadow-[0_2px_10px_rgba(37,99,235,0.5)] md:text-left">{titleleft}</p>}
        <div class="mt-2 text-center text-sm font-medium text-blue-300 md:text-left">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-3 md:pl-6">
        {
          titleright && (
            <h2 class="flex flex-col gap-2 text-xl font-black text-white drop-shadow-[0_0_8px_rgba(37,99,235,0.4)] md:text-2xl">
              {titleright}
              <span class="h-[3px] w-24 rounded-full bg-gradient-to-r from-yellow-400 via-red-500 to-transparent" />
            </h2>
          )
        }
        <div class="text-base leading-relaxed text-blue-100/80">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
