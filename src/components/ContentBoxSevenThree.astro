---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-amber-400/30 bg-[#04170d]/80 p-8 text-emerald-50/85 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article
        class="flex flex-col gap-4 border-b border-emerald-800/60 pb-6 text-center text-base font-medium text-amber-300 md:border-r md:border-b-0 md:pr-6 md:pb-0 md:text-left">
        {
          titleleft && (
            <h2 class="text-center text-3xl leading-normal font-black tracking-wide text-white drop-shadow-[0_2px_10px_rgba(251,191,36,0.35)] md:text-left">{titleleft}</h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-emerald-50/85 md:pl-6">
        {
          titleright && (
            <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-amber-300 drop-shadow-[0_0_8px_rgba(251,191,36,0.35)]">{titleright}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
