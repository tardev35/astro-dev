---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-amber-500/45 bg-[#0d0304]/90 p-8 text-white/90 shadow-[0_0_25px_rgba(245,158,11,0.18)] backdrop-blur-md transition-all duration-300 hover:border-amber-400 hover:shadow-[0_0_40px_rgba(245,158,11,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-amber-400 to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-red-600 to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-amber-400 to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-red-600 to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-amber-50/80">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-amber-500/35 pb-2">
              <span class="font-mono text-red-500" aria-hidden="true">
                &gt;_
              </span>
              <h2 class="text-xl leading-normal font-black tracking-wide text-amber-300">{titleleft}</h2>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-amber-50/80 md:border-l md:border-amber-500/30 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-amber-500/35 pb-2">
              <span class="font-mono text-red-500" aria-hidden="true">
                &gt;_
              </span>
              <h2 class="text-xl leading-normal font-black tracking-wide text-amber-300">{titleright}</h2>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
