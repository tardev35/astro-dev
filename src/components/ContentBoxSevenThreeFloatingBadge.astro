---
const { title, titleleft, titleright } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative w-full max-w-7xl rounded-2xl border-2 border-amber-400/40 bg-gradient-to-b from-[#062b16] to-[#04170d] p-8 pt-24 shadow-[0_10px_40px_rgba(0,0,0,0.5)] sm:pt-20">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-amber-400/50 bg-[#04170d] px-4 py-2.5 text-center shadow-[0_5px_15px_rgba(251,191,36,0.3)] sm:px-8">
          <h2 class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-base leading-normal font-black tracking-wide text-transparent sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr]">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-emerald-50/85">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-amber-300 drop-shadow-[0_0_5px_rgba(251,191,36,0.4)]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-emerald-50/85 md:border-l md:border-amber-400/30 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-amber-300 drop-shadow-[0_0_5px_rgba(251,191,36,0.4)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
