---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border-2 border-amber-400/35 bg-[#1a0505]/85 p-8 text-white/90 shadow-[0_10px_30px_rgba(74,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 hover:shadow-[0_15px_40px_rgba(220,38,38,0.3)] md:p-10">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
    <div class="pointer-events-none absolute -top-24 -right-24 h-48 w-48 rounded-full bg-red-600/20 blur-[60px] transition-all duration-500 group-hover:bg-red-500/30"></div>

    <div class="relative z-10 grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-base leading-relaxed text-amber-50/85">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-base leading-relaxed text-amber-50/85 md:border-l md:border-amber-500/30 md:pl-10">
        {
          titleright && (
            <h2 class="mb-2 bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
