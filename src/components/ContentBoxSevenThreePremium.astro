---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-blue-500/35 bg-[#040b1e]/85 p-8 text-white/90 shadow-[0_10px_30px_rgba(37,99,235,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-blue-400/60 hover:shadow-[0_15px_40px_rgba(37,99,235,0.35)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -right-16 h-44 w-44 rounded-full bg-red-600/15 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-16 h-44 w-44 rounded-full bg-blue-600/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-yellow-400/60 to-transparent"></div>

    <div class="relative z-10 grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-base leading-relaxed text-blue-100/80">
        {titleleft && <p class="bg-gradient-to-r from-blue-200 to-blue-400 bg-clip-text text-center text-xl leading-normal font-black tracking-wide text-transparent md:text-left">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-base leading-relaxed text-blue-100/80 md:border-l md:border-blue-500/30 md:pl-10">
        {
          titleright && (
            <h2 class="mb-2 flex flex-col gap-2 text-xl leading-normal font-black tracking-wide text-white drop-shadow-sm md:text-2xl">
              {titleright}
              <span class="h-[3px] w-24 rounded-full bg-gradient-to-r from-yellow-400 via-red-500 to-transparent" />
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
