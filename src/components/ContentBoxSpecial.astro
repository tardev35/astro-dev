---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-amber-400/35 bg-[#04170d]/85 p-6 text-emerald-50/85 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-amber-300/60 md:p-10">
    <div
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-amber-400 to-transparent opacity-60 shadow-[0_0_15px_rgba(251,191,36,0.8)] transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-400/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-amber-200 via-amber-400 to-emerald-600 shadow-[0_0_15px_rgba(251,191,36,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent drop-shadow-sm">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-amber-400/20 bg-[#062b16]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-amber-300/60 hover:bg-[#0a3d22] hover:shadow-[0_15px_30px_rgba(251,191,36,0.18)]">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-amber-300/50 bg-gradient-to-br from-amber-300 to-amber-600 text-2xl shadow-[0_0_10px_rgba(251,191,36,0.5)]">
          💳
        </div>
        <div class="text-left text-base leading-relaxed text-emerald-50/85">
          <slot name="left" />
        </div>
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-emerald-600/30 bg-[#062b16]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-emerald-400/60 hover:bg-[#0a3d22] hover:shadow-[0_15px_30px_rgba(16,185,129,0.2)]">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-emerald-400/50 bg-gradient-to-br from-emerald-500 to-emerald-900 text-2xl shadow-[0_0_10px_rgba(16,185,129,0.5)]">
          🕑
        </div>
        <div class="text-left text-base leading-relaxed text-emerald-50/85">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
