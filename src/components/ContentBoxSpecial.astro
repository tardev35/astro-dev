---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-red-600/30 bg-[#0a0a0a]/80 p-6 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-red-500/40 md:p-10">
    <div
      class="pointer-events-none absolute top-0 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-red-500 to-transparent opacity-50 shadow-[0_0_15px_rgba(220,38,38,0.8)] transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-red-600/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-red-500 to-red-700 shadow-[0_0_15px_rgba(220,38,38,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-white/5 bg-[#171717]/60 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-red-500/50 hover:bg-[#1a0505] hover:shadow-[0_15px_30px_rgba(220,38,38,0.15)]">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-red-400/30 bg-gradient-to-br from-red-600 to-red-800 text-2xl shadow-[0_0_10px_rgba(220,38,38,0.5)]">
          🎁
        </div>
        <div class="text-sm leading-relaxed text-gray-300">
          <slot name="left" />
        </div>
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-white/5 bg-[#171717]/60 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-yellow-500/50 hover:bg-[#1a1505] hover:shadow-[0_15px_30px_rgba(250,204,21,0.15)]">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 text-2xl shadow-[0_0_10px_rgba(250,204,21,0.5)]">
          ⚠️
        </div>
        <div class="text-sm leading-relaxed text-gray-300">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
