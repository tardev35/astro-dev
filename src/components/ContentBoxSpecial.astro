---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-amber-500/35 bg-[#0a0604]/85 p-6 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-amber-400/60 md:p-10">
    <div
      class="pointer-events-none absolute top-0 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-amber-400 to-transparent opacity-60 shadow-[0_0_15px_rgba(245,158,11,0.8)] transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-amber-500/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-amber-200 via-amber-400 to-red-600 shadow-[0_0_15px_rgba(245,158,11,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent drop-shadow-sm">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-amber-500/15 bg-[#160707]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-amber-400/50 hover:bg-[#1a1004] hover:shadow-[0_15px_30px_rgba(245,158,11,0.15)]">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-amber-300/50 bg-gradient-to-br from-amber-400 to-amber-600 text-2xl shadow-[0_0_10px_rgba(245,158,11,0.5)]">
          💰
        </div>
        <div class="text-left text-base leading-relaxed text-amber-50/80">
          <slot name="left" />
        </div>
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-red-700/25 bg-[#160707]/70 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-red-500/60 hover:bg-[#1c060c] hover:shadow-[0_15px_30px_rgba(220,38,38,0.18)]">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-red-400/50 bg-gradient-to-br from-red-600 to-red-900 text-2xl shadow-[0_0_10px_rgba(220,38,38,0.5)]">
          🔐
        </div>
        <div class="text-left text-base leading-relaxed text-amber-50/80">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
