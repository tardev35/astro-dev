---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-blue-50/85">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-amber-400/40 pb-3 text-xl leading-normal font-black tracking-wide text-amber-100 drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-amber-300/50 bg-gradient-to-br from-amber-300 to-amber-600 text-sm text-[#04102e] shadow-[0_0_10px_rgba(251,191,36,0.5)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-blue-50/85">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-amber-400/40 pb-3 text-xl leading-normal font-black tracking-wide text-amber-100 drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-blue-400/40 bg-gradient-to-br from-blue-600 to-blue-900 text-sm text-white shadow-[0_0_10px_rgba(37,99,235,0.5)]">
              💰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
