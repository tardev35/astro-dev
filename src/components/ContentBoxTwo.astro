---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-blue-500/30 pb-3 text-xl font-black tracking-wide text-white drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-blue-400/40 bg-gradient-to-br from-blue-600 to-blue-900 text-sm text-white shadow-[0_0_10px_rgba(37,99,235,0.5)]">🔐</span>
            {titleleft}
          </p>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="left" /></div>
    </article>

    <article class="flex flex-col gap-4">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-blue-500/30 pb-3 text-xl font-black tracking-wide text-white drop-shadow-md">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 text-sm text-[#040b1e] shadow-[0_0_10px_rgba(250,204,21,0.5)]">💰</span>
            {titleright}
          </p>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="right" /></div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
