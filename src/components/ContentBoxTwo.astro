---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-white/90">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-red-600/40 pb-3 text-xl leading-normal font-black tracking-widest text-white uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-red-400/40 bg-gradient-to-br from-red-600 to-red-900 text-sm text-white shadow-[0_0_10px_rgba(220,38,38,0.5)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-white/90">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-red-600/40 pb-3 text-xl leading-normal font-black tracking-widest text-white uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-300/50 bg-gradient-to-br from-amber-400 to-amber-600 text-sm text-black shadow-[0_0_10px_rgba(245,158,11,0.5)]">
              💰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
