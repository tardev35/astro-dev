---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-lime-50/85">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-lime-400/40 pb-3 text-xl leading-normal font-black tracking-wide text-lime-100 drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-lime-300/50 bg-gradient-to-br from-lime-400 to-green-600 text-sm text-[#04120a] shadow-[0_0_10px_rgba(163,230,53,0.5)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-lime-50/85">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-lime-400/40 pb-3 text-xl leading-normal font-black tracking-wide text-lime-100 drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-green-400/40 bg-gradient-to-br from-green-600 to-green-900 text-sm text-white shadow-[0_0_10px_rgba(34,197,94,0.5)]">
              💰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
