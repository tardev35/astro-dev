---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4">
      {
        titleleft && (
          <h2 class="flex items-center gap-3 border-b border-amber-500/30 pb-3 text-xl font-black tracking-widest text-slate-100 uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-400/30 bg-gradient-to-br from-amber-500 to-amber-700 text-sm text-[#0b1120] shadow-[0_0_10px_rgba(251,191,36,0.5)]">
              🔐
            </span>
            {titleleft}
          </h2>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="left" /></div>
    </article>

    <article class="flex flex-col gap-4">
      {
        titleright && (
          <h2 class="flex items-center gap-3 border-b border-slate-400/30 pb-3 text-xl font-black tracking-widest text-slate-100 uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200/50 bg-gradient-to-br from-slate-200 to-slate-400 text-sm text-[#0b1120] shadow-[0_0_10px_rgba(203,213,225,0.5)]">
              💰
            </span>
            {titleright}
          </h2>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="right" /></div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
