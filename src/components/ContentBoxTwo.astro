---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4">
      {
        titleleft && (
          <h2 class="flex items-center gap-3 border-b border-amber-500/30 pb-3 text-xl font-black tracking-widest text-amber-50 uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-300/40 bg-gradient-to-br from-amber-400 to-amber-600 text-sm text-[#14040a] shadow-[0_0_10px_rgba(251,191,36,0.5)]">
              🔐
            </span>
            {titleleft}
          </h2>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="left" /></div>
    </article>

    <article class="flex flex-col gap-4">
      {
        titleright && (
          <h2 class="flex items-center gap-3 border-b border-red-500/40 pb-3 text-xl font-black tracking-widest text-amber-50 uppercase drop-shadow-md">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-red-400/50 bg-gradient-to-br from-red-500 to-red-700 text-sm text-[#14040a] shadow-[0_0_10px_rgba(220,38,38,0.55)]">
              💰
            </span>
            {titleright}
          </h2>
        )
      }
      <div class="h-full text-base leading-relaxed text-white/90"><slot name="right" /></div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
