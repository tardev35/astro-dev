---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-blue-600/30 bg-[#04102e]/80 p-8 text-white/90 shadow-[0_10px_30px_rgba(30,64,175,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-blue-500/60 hover:shadow-[0_15px_40px_rgba(37,99,235,0.25)] md:p-10">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-blue-900/10 to-transparent opacity-50"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-blue-50/85">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-blue-800/50 pb-3 text-xl leading-normal font-black tracking-widest text-amber-400 uppercase">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-sm shadow-[0_0_10px_rgba(245,158,11,0.3)]">👑</span>
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-blue-50/85 md:border-l md:border-blue-800/50 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-blue-800/50 pb-3 text-xl leading-normal font-black tracking-widest text-amber-400 uppercase">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-sm shadow-[0_0_10px_rgba(245,158,11,0.3)]">👑</span>
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
