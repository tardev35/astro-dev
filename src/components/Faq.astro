---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  faqs?: FaqItem[];
  title?: string;
}

const {
  title = "คำถามที่พบบ่อย (FAQ) เกี่ยวกับการใช้งาน PORING168",
  faqs = [
    {
      q: "การ ฝากถอน ผ่านระบบอัตโนมัติใช้เวลานานหรือไม่?",
      a: "ประมวลผลด้วยความไวสูง ยอดเงินอัปเดตเข้ากระเป๋าในไม่กี่วินาที สะดวกรวดเร็ว และแม่นยำที่สุด",
    },
    {
      q: "ทำไม สล็อตเว็บตรง ถึงต้องมีนโยบายทางการเงินที่เปิดกว้าง?",
      a: "เพื่อให้ผู้ใช้งานได้ สัมผัสความยืดหยุ่นทางการเงินขั้นสุด สามารถบริหารทุนของตนเองได้อย่างอิสระโดย ไม่มีขั้นต่ำ",
    },
    {
      q: "แอปพลิเคชันที่ใช้ รองรับทรูวอเลท มีค่าธรรมเนียมเพิ่มเติมไหม?",
      a: "ไม่มีค่าธรรมเนียมแอบแฝงใดๆ ทั้งสิ้น แพลตฟอร์ม PORING168 ให้คุณทำธุรกรรมได้ฟรีและ ลื่นไหล ตลอดเวลา",
    },
    {
      q: "ข้อมูลส่วนตัวและยอดเครดิตจะได้รับการปกป้องอย่างไร?",
      a: "เราใช้เทคโนโลยีความปลอดภัยระดับ มาตรฐานสากล ทำให้มั่นใจได้ว่าทุกข้อมูลของคุณจะ ปลอดภัย 100%",
    },
  ],
} = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <p class="mb-8 bg-gradient-to-b from-amber-200 to-amber-500 bg-clip-text text-center text-2xl font-black tracking-tighter text-transparent uppercase italic md:text-4xl">
    {title}
  </p>

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <div class="faq-item group overflow-hidden rounded-xl border border-amber-400/20 bg-gradient-to-br from-[#07215f] to-[#04102e] transition-all hover:border-amber-400/50">
          <button type="button" class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="text-base font-bold text-blue-50/90">{faq.q}</span>
            <span class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-amber-400/40 text-lg leading-none font-black text-amber-400 transition-transform duration-300">
              +
            </span>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-white/5 p-5 pt-0 text-left text-base leading-relaxed text-blue-50/70">{faq.a}</div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #60a5fa !important;
    color: #60a5fa !important;
  }
  .faq-item.active {
    border-color: rgba(251, 191, 36, 0.6);
    box-shadow: 0 0 20px rgba(4, 16, 46, 0.5);
  }
  p,
  .space-y-4 {
    font-family: "kanit", sans-serif;
  }
</style>
