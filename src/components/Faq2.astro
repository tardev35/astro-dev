---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  faqs?: FaqItem[];
}

const {
  faqs = [
    {
      q: "ระบบคาสิโน API แท้ ดีกว่าเว็บที่ผ่านเอเย่นต์ทั่วไปอย่างไร?",
      a: "ช่วยให้ระบบโปร่งใสและไม่มีการล็อคยูสเซอร์จากหลังบ้านครับ ทำให้โบนัสแตกง่าย จ่ายผลตอบแทนและสุ่มรางวัลอย่างยุติธรรมตามสถิติสากล 100%",
    },
    {
      q: "นวัตกรรมฝากถอนออโต้อัจฉริยะ ช่วยเพิ่มสภาพคล่องแบบไหน?",
      a: "ช่วยโอนเงินสดเข้าบัญชีคุณทันทีในเสี้ยววินาทีเมื่อกดถอนครับ ไม่ต้องรอคิวแอดมิน ทำให้โยกย้ายเงินเพื่อปั้นพอร์ตหรือนำไปใช้จ่ายได้รวดเร็วทันใจ",
    },
    {
      q: "โหมดเดโม่ทดลองเล่นฟรี มีประโยชน์ต่อนักลงทุนมือใหม่อย่างไร?",
      a: "ช่วยให้คุณได้ศึกษากลไกและจังหวะของแต่ละเกมก่อนลงสนามจริงครับ ทำให้ค้นหารูปแบบที่เข้ากับสไตล์ตัวเองและช่วยลดความเสี่ยงในการลงทุนได้อย่างดีเยี่ยม",
    },
  ],
}: Props = Astro.props;
---

<section class="mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span class="text-2xl drop-shadow-[0_0_10px_rgba(245,158,11,0.7)]">❔</span>
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl font-black tracking-wide text-transparent drop-shadow-sm">คำถามที่พบบ่อยเกี่ยวกับ KINGHENG168</p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="space-y-5">
    {
      faqs.map((item) => (
        <div class="group relative bg-[#1a0505] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
          <div class="absolute inset-0 bg-gradient-to-r from-amber-500 via-amber-600/40 to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

          <div class="relative bg-[#0d0304] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
            <button type="button" class="sport-faq-btn flex w-full items-center gap-4 text-left">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-amber-300 to-amber-600 font-black text-[#1a1206] [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">?</span>
              <span class="flex-1 text-base font-bold tracking-tight text-amber-50">{item.q}</span>
              <span class="arrow text-amber-400 transition-transform duration-300">▼</span>
            </button>

            <div class="sport-content max-h-0 overflow-hidden transition-all duration-300">
              <p class="mt-4 border-l-2 border-amber-500 pl-4 text-left text-base leading-relaxed text-amber-50/75">{item.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const btns = document.querySelectorAll(".sport-faq-btn");
  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling as HTMLElement;
      const arrow = btn.querySelector(".arrow");
      if (content.style.maxHeight === "0px" || !content.style.maxHeight) {
        content.style.maxHeight = content.scrollHeight + "px";
        arrow?.classList.add("rotate-180");
      } else {
        content.style.maxHeight = "0px";
        arrow?.classList.remove("rotate-180");
      }
    });
  });
</script>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
