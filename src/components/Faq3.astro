---
const faqs = [
  {
    q: "API แท้ช่วยเพิ่มความมั่นใจในการปั่นสล็อตได้อย่างไร?",
    a: "ช่วยให้ระบบโปร่งใสและไม่มีการล็อคยูสเซอร์จากหลังบ้านครับ ทำให้โบนัสแตกง่าย จ่ายผลตอบแทนและสุ่มรางวัลอย่างยุติธรรมตามสถิติสากล 100%",
  },
  {
    q: "ระบบฝากถอนอัตโนมัติช่วยเพิ่มสภาพคล่องแบบไหน?",
    a: "ช่วยโอนเงินสดเข้าบัญชีคุณทันทีในเสี้ยววินาทีเมื่อกดถอนครับ ไม่ต้องรอคิวแอดมิน ทำให้โยกย้ายเงินเพื่อปั้นพอร์ตหรือนำไปใช้จ่ายได้รวดเร็วทันใจ",
  },
  {
    q: "โหมดทดลองเล่นฟรี มีประโยชน์ต่อนักลงทุนมือใหม่อย่างไร?",
    a: "ช่วยให้คุณได้ศึกษากลไกและค่า RTP ของแต่ละเกมก่อนลงสนามจริงครับ ทำให้ค้นหารูปแบบที่เข้ากับสไตล์ตัวเองและลดความเสี่ยงในการลงทุนได้อย่างดีเยี่ยม",
  },
];
---

<div class="mx-auto max-w-[700px] space-y-3 p-4 font-sans">
  <div class="mb-6 flex flex-col items-center gap-2 text-center">
    <h2 class="bg-gradient-to-r from-slate-100 via-slate-300 to-amber-400 bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">คำถามที่พบบ่อยเกี่ยวกับ NOVA852</h2>
    <div class="h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  {
    faqs.map((faq) => (
      <div class="rounded-3xl border border-slate-400/20 bg-[#0b1120]/60 p-2 shadow-lg backdrop-blur-xl transition-all hover:border-amber-400/40 hover:bg-[#0b1120]/80">
        <button class="glass-faq-btn flex w-full cursor-pointer items-center justify-between p-4 font-bold text-slate-100 transition-colors hover:text-amber-400">
          <span class="text-left text-sm md:text-base">{faq.q}</span>

          <span class="icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">+</span>
        </button>

        <div class="glass-faq-content grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out">
          <div class="overflow-hidden">
            <p class="px-4 pb-4 text-sm leading-relaxed text-slate-300/80 md:text-base">{faq.a}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>

<script>
  const btns = document.querySelectorAll(".glass-faq-btn");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector(".icon");

      const isOpen = content?.classList.contains("grid-rows-[1fr]");

      if (!isOpen) {
        content?.classList.replace("grid-rows-[0fr]", "grid-rows-[1fr]");
        content?.classList.replace("opacity-0", "opacity-100");
        icon?.classList.add("rotate-45", "text-amber-400");
      } else {
        content?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
        content?.classList.replace("opacity-100", "opacity-0");
        icon?.classList.remove("rotate-45", "text-amber-400");
      }
    });
  });
</script>
