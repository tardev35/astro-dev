---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const {
  title = "คำถามที่พบบ่อย",
  faqs = [
    {
      q: "รองรับระบบ True Wallet หรือไม่?",
      a: "รองรับเต็มรูปแบบ ทั้ง TrueMoney Wallet และบัญชีธนาคารชั้นนำ ฝากถอนผ่านระบบออโต้ได้ตลอด 24 ชั่วโมง ไม่ต้องรอคิว",
    },
    {
      q: "ถอนเงินขั้นต่ำเท่าไหร่?",
      a: "ทำรายการผ่านระบบออโต้ได้ทันทีโดยไม่ต้องรอแอดมินยืนยัน ระบบประมวลผลและโอนเข้าบัญชีให้ภายในไม่กี่วินาที",
    },
  ],
} = Astro.props;
---

<section class="relative z-10 mx-auto max-w-[760px] px-4 py-6 font-sans">
  <div class="mb-5 flex flex-col items-center gap-2 text-center">
    <p class="bg-gradient-to-r from-blue-300 via-white to-yellow-300 bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-sm md:text-2xl">{title}</p>
    <div class="h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <div class="rounded-3xl border border-blue-500/30 bg-[#071433]/70 p-2 shadow-[0_5px_20px_rgba(0,0,0,0.35)] backdrop-blur-xl transition-all hover:border-blue-400/60 hover:bg-[#0a1a3d]/80">
          <button class="glass-faq-btn flex w-full cursor-pointer items-center justify-between p-4 text-left font-bold text-white transition-colors hover:text-blue-300">
            <span class="text-sm md:text-base">{faq.q}</span>
            <span class="icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl text-yellow-300 transition-transform duration-300 ease-in-out">+</span>
          </button>

          <div class="glass-faq-content grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out">
            <div class="overflow-hidden">
              <p class="px-4 pb-4 text-sm leading-relaxed text-blue-100/75 md:text-base">{faq.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>

<script>
  document.querySelectorAll(".glass-faq-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector(".icon");
      const isOpen = content?.classList.contains("grid-rows-[1fr]");

      if (!isOpen) {
        content?.classList.replace("grid-rows-[0fr]", "grid-rows-[1fr]");
        content?.classList.replace("opacity-0", "opacity-100");
        icon?.classList.add("rotate-45", "text-red-400");
      } else {
        content?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
        content?.classList.replace("opacity-100", "opacity-0");
        icon?.classList.remove("rotate-45", "text-red-400");
      }
    });
  });
</script>
