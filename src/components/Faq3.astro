---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  faqs?: FaqItem[];
}

const {
  faqs = [
    {
      q: "โปรโมชั่นทุนน้อยของ EZWIN168 เหมาะกับใคร?",
      a: "เหมาะกับผู้ที่ต้องการเริ่มต้นด้วยงบประมาณจำกัด แต่ควรตรวจสอบยอดฝากขั้นต่ำ เงื่อนไขการทำรายการ เกมที่เข้าร่วม และข้อกำหนดการถอนก่อนรับสิทธิ์",
    },
    {
      q: "EZWIN168 คืนยอดเสียอย่างไร?",
      a: "การคืนยอดเสียมักคำนวณจากยอดขาดทุนสุทธิในช่วงเวลาที่กำหนด โดยอัตราคืนและยอดสูงสุดขึ้นอยู่กับเงื่อนไขของแต่ละโปรโมชั่น",
    },
    {
      q: "EZWIN168 จ่ายทุกบิลจริงหรือไม่?",
      a: "การอนุมัติรายการขึ้นอยู่กับยอดคงเหลือ สถานะบัญชี และการปฏิบัติตามเงื่อนไข สมาชิกควรตรวจสอบข้อมูลและข้อกำหนดล่าสุดก่อนส่งคำขอถอน",
    },
  ],
}: Props = Astro.props;
---

<section class="mx-auto mb-10 w-full max-w-[760px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span class="text-2xl drop-shadow-[0_0_10px_rgba(251,191,36,0.7)]">❔</span>
    <p class="bg-gradient-to-r from-white via-amber-100 to-amber-300 bg-clip-text text-2xl font-black tracking-wide text-transparent drop-shadow-sm">คำถามที่พบบ่อยเกี่ยวกับ EZWIN168</p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <div class="rounded-3xl border border-amber-400/25 bg-[#062b16]/60 p-2 shadow-lg backdrop-blur-xl transition-all hover:border-amber-300/50 hover:bg-[#0a3d22]/60">
          <button type="button" class="glass-faq-btn flex w-full cursor-pointer items-center justify-between p-4 font-bold text-emerald-50 transition-colors hover:text-amber-300">
            <span class="text-left text-base">{faq.q}</span>

            <span class="icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl text-amber-300 transition-transform duration-300 ease-in-out">+</span>
          </button>

          <div class="glass-faq-content grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out">
            <div class="overflow-hidden">
              <p class="border-l-2 border-amber-400/60 px-4 pb-4 text-left text-base leading-relaxed text-emerald-50/75">{faq.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const btns = document.querySelectorAll(".glass-faq-btn");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector(".icon");
      const isOpen = content?.classList.contains("grid-rows-[1fr]");

      if (!isOpen) {
        content?.classList.replace("grid-rows-[0fr]", "grid-rows-[1fr]");
        content?.classList.replace("opacity-0", "opacity-100");
        icon?.classList.add("rotate-45", "text-amber-400");
      } else {
        content?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
        content?.classList.replace("opacity-100", "opacity-0");
        icon?.classList.remove("rotate-45", "text-amber-400");
      }
    });
  });
</script>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
