---
const faqs = [
  {
    q: "ระบบคาสิโน API แท้ ดีเฮง789 ดีกว่าเว็บที่ผ่านเอเย่นต์ทั่วไปอย่างไร?",
    a: "ช่วยให้ระบบโปร่งใสและไม่มีการล็อคยูสเซอร์จากหลังบ้านครับ ทำให้โบนัสแตกง่าย จ่ายผลตอบแทนและสุ่มรางวัลอย่างยุติธรรมตามสถิติสากล 100%",
  },
  {
    q: "นวัตกรรมฝากถอนออโต้อัจฉริยะ ช่วยเพิ่มสภาพคล่องแบบไหน?",
    a: "ช่วยโอนเงินสดเข้าบัญชีคุณทันทีในเสี้ยววินาทีเมื่อกดถอนครับ ไม่ต้องรอคิวแอดมิน ทำให้โยกย้ายเงินเพื่อปั้นพอร์ตหรือนำไปใช้จ่ายได้รวดเร็วทันใจ",
  },
  {
    q: "การฝากถอนแบบไม่มีขั้นต่ำ มีประโยชน์ต่อนักลงทุนมือใหม่อย่างไร?",
    a: "ช่วยให้คุณสามารถเริ่มต้นลงทุนด้วยงบเท่าไหร่ก็ได้ครับ ทำให้บริหารจัดการความเสี่ยงได้ง่ายขึ้น และถอนกำไรออกไปใช้ได้อย่างอิสระไร้เงื่อนไขผูกมัด",
  },
];
---

<div class="relative z-10 mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <div
    class="mb-8 flex items-center gap-3 border-l-4 border-amber-400 bg-gradient-to-r from-red-900/60 via-red-900/20 to-transparent px-4 py-2.5"
    style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <h2 class="text-xl font-black tracking-widest text-amber-400 uppercase drop-shadow-[0_0_8px_rgba(220,38,38,0.5)] md:text-2xl">คำถามที่พบบ่อยเกี่ยวกับการใช้งาน ดีเฮง789 ของแท้</h2>
  </div>

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <div
          class="faq-item group relative overflow-hidden border border-red-500/35 bg-[#14040a]/85 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/70 hover:shadow-[0_0_20px_rgba(220,38,38,0.25)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-amber-400 to-transparent" />

          <button class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-sm font-bold text-white/90 transition-colors group-hover:text-amber-200 md:text-lg">
              <span class="font-mono text-amber-400">&gt;_</span> {faq.q}
            </span>

            <span
              class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-red-500/50 bg-[#4a0000]/60 text-lg leading-none font-black text-amber-400 transition-all duration-300 group-hover:border-amber-400 group-hover:text-amber-300 group-hover:shadow-[0_0_10px_rgba(251,191,36,0.5)]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </button>

          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-red-500/25 p-5 pt-0 text-sm leading-relaxed text-red-50/75 md:text-base">{faq.a}</div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #fbbf24 !important;
    color: #fbbf24 !important;
  }
  .faq-item.active {
    border-color: rgba(251, 191, 36, 0.6);
    box-shadow: 0 0 20px rgba(220, 38, 38, 0.45);
  }
  h2,
  .space-y-4 {
    font-family: "Kanit", sans-serif;
  }
</style>
