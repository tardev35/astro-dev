---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-blue-500/25 bg-[#040b1e]/60 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold ? "hover:border-yellow-400/50 hover:bg-[#0a1a3d] hover:shadow-[0_10px_20px_rgba(250,204,21,0.15)]" : "hover:border-blue-400/60 hover:bg-[#071433] hover:shadow-[0_10px_20px_rgba(37,99,235,0.2)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 shadow-[0_0_15px_rgba(250,204,21,0.4)] group-hover:rotate-3"
                : "border border-blue-400/50 bg-gradient-to-br from-blue-500 to-blue-800 shadow-[0_0_15px_rgba(37,99,235,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-yellow-200 to-yellow-500 bg-clip-text text-transparent" : "bg-gradient-to-r from-white to-blue-300 bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-blue-100/60 transition-colors group-hover:text-blue-100/90">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
