---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "lime" | "green";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isLime = item.accent !== "green";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border bg-[#04120a]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isLime
              ? "border-lime-400/25 hover:border-lime-300/60 hover:bg-[#0a1a0e] hover:shadow-[0_10px_20px_rgba(163,230,53,0.18)]"
              : "border-green-800/50 hover:border-green-500/60 hover:bg-[#061409] hover:shadow-[0_10px_20px_rgba(34,197,94,0.2)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isLime
                ? "border border-lime-300/50 bg-gradient-to-br from-lime-300 to-lime-600 shadow-[0_0_15px_rgba(163,230,53,0.5)] group-hover:rotate-3"
                : "border border-green-500/50 bg-gradient-to-br from-green-600 to-green-900 shadow-[0_0_15px_rgba(34,197,94,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isLime
                  ? "bg-gradient-to-r from-lime-100 to-lime-400 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-green-200 to-green-400 bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-lime-50/75 transition-colors group-hover:text-lime-50/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
