---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "red";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "red";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "border-amber-700/40 bg-[#1a0505]/70 hover:border-amber-400/60 hover:bg-[#24080a] hover:shadow-[0_10px_20px_rgba(251,191,36,0.18)]"
              : "border-red-600/30 bg-[#14040a]/70 hover:border-red-400/60 hover:bg-[#210608] hover:shadow-[0_10px_20px_rgba(220,38,38,0.2)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-amber-300/50 bg-gradient-to-br from-amber-400 to-amber-600 shadow-[0_0_15px_rgba(251,191,36,0.4)] group-hover:rotate-3"
                : "border border-red-400/50 bg-gradient-to-br from-red-500 to-red-800 shadow-[0_0_15px_rgba(220,38,38,0.4)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-yellow-300 to-amber-500 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-red-100/70 transition-colors group-hover:text-red-50/90">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
