---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "red";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "red";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border bg-[#140406]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "border-amber-500/25 hover:border-amber-400/60 hover:bg-[#1a1004] hover:shadow-[0_10px_20px_rgba(245,158,11,0.18)]"
              : "border-red-800/40 hover:border-red-500/60 hover:bg-[#1c060c] hover:shadow-[0_10px_20px_rgba(220,38,38,0.2)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-amber-300/50 bg-gradient-to-br from-amber-300 to-amber-600 shadow-[0_0_15px_rgba(245,158,11,0.5)] group-hover:rotate-3"
                : "border border-red-500/50 bg-gradient-to-br from-red-600 to-red-900 shadow-[0_0_15px_rgba(220,38,38,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-amber-100 to-amber-400 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-red-200 to-red-400 bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-amber-50/70 transition-colors group-hover:text-amber-50/90">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
