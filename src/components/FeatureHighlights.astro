---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "blue";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border bg-[#04102e]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "border-amber-400/25 hover:border-amber-300/60 hover:bg-[#0e3486] hover:shadow-[0_10px_20px_rgba(251,191,36,0.18)]"
              : "border-blue-800/60 hover:border-blue-500/60 hover:bg-[#07215f] hover:shadow-[0_10px_20px_rgba(37,99,235,0.2)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-amber-300/50 bg-gradient-to-br from-amber-300 to-amber-600 shadow-[0_0_15px_rgba(251,191,36,0.5)] group-hover:rotate-3"
                : "border border-blue-500/50 bg-gradient-to-br from-blue-600 to-blue-900 shadow-[0_0_15px_rgba(37,99,235,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <h3
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-amber-100 to-amber-400 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-blue-100 to-blue-400 bg-clip-text text-transparent"
              }`}>
              {item.title}
            </h3>
            <p class="text-left text-base leading-relaxed text-blue-50/75 transition-colors group-hover:text-blue-50/95">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
