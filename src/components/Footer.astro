---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-amber-500 bg-[#14040a] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(220,38,38,0.2)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-red-700/15 blur-[80px]"></div>
  <div class="pointer-events-none absolute right-0 bottom-0 h-64 w-64 rounded-full bg-amber-500/10 blur-[90px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-amber-500/40 bg-white px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="ดีเฮง789" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="text-3xl font-black tracking-widest text-[#14040a]">
                ดีเฮง<span class="text-red-600">789</span>
              </p>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-amber-500 pl-4 text-sm leading-relaxed text-red-50/70">
          เว็บไซต์ทางการ ดีเฮง789 สล็อตสุดเฮงแตกง่าย เชื่อมต่อระบบ API แท้ไม่ล็อคยูสเซอร์ รวมเกมสล็อต คาสิโนสด และกีฬาไว้ในที่เดียว ฝากถอนสะดวกออโต้ ไม่มีขั้นต่ำ จ่ายจริงเต็ม 100%
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-red-500/40 bg-red-900/40 px-3 py-1 text-[10px] font-bold text-red-300">100% SECURE</span>
          <span class="rounded-sm border border-amber-500/40 bg-amber-500/10 px-3 py-1 text-[10px] font-bold text-amber-400">OFFICIAL PARTNER</span>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-amber-500/30 pb-2 text-base font-black tracking-widest text-white uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-red-50/70">
          {
            [
              { name: "หน้าแรก", path: "/" },
              { name: "โปรโมชั่น", path: "/promotion" },
              { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
              { name: "ทางเข้า", path: "/ทางเข้า" },
              { name: "บทความ", path: "/บทความ" },
              { name: "เกี่ยวกับเรา", path: "/about-us" },
              { name: "ติดต่อเรา", path: "/contact-us" },
              { name: "สมัครสมาชิก", path: "/register" },
            ].map((link) => (
              <li>
                <a href={link.path} class="flex items-center gap-2 transition-colors hover:text-amber-400">
                  <span class="text-amber-500">▸</span> {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-amber-500/30 pb-2 text-base font-black tracking-widest text-white uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-[#00B900] py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน (LINE)
        </a>

        <div class="mt-2 text-xs font-bold text-amber-500/80">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <div class="flex flex-wrap gap-2">
          <div class="rounded border border-amber-500/20 bg-[#118A44] px-2 py-1 font-mono text-[10px] font-bold text-white">KBANK</div>
          <div class="rounded border border-amber-500/20 bg-[#4E2B7A] px-2 py-1 font-mono text-[10px] font-bold text-white">SCB</div>
          <div class="rounded border border-amber-500/20 bg-[#1BA1E2] px-2 py-1 font-mono text-[10px] font-bold text-white">KTB</div>
          <div class="rounded border border-amber-500/20 bg-gradient-to-r from-orange-500 to-orange-400 px-2 py-1 font-mono text-[10px] font-bold text-white">TRUE WALLET</div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-white/10 pt-6 text-xs font-medium text-red-50/50 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} <span class="font-bold text-amber-400">DEEHENG789</span>. ALL RIGHTS RESERVED. ดีเฮง789 สล็อตสุดเฮงแตกง่าย</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-amber-400">เงื่อนไขข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-amber-400">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
