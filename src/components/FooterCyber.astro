---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-amber-500/50 bg-[#0a0806] pt-16 pb-8 font-sans text-white"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(#dc2626 1px, transparent 1px), linear-gradient(90deg, #eab308 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="PABLO666 Logo" class="h-[60px] w-auto drop-shadow-[0_0_15px_rgba(234,179,8,0.5)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-amber-400">PABLO666</h2>
            )
          }
        </a>
        <p class="border-l-2 border-amber-500 pl-4 text-sm leading-relaxed text-amber-100/70">
          PABLO666 เว็บสล็อตออนไลน์ระบบเว็บตรง รวมสล็อต คาสิโนสด เกมโต๊ะ และกีฬาไว้ในบัญชีเดียว ระบบออโต้ ฝาก-ถอนรวดเร็ว รองรับฝากขั้นต่ำ 1 บาท เสถียร รองรับการใช้งานทุกอุปกรณ์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-red-500/30 bg-red-900/40 px-3 py-1 font-mono text-xs text-red-300">AUTO_SYSTEM</span>
          <span class="border border-yellow-500/30 bg-yellow-900/40 px-3 py-1 font-mono text-xs text-yellow-400">100%_SECURE</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-yellow-400 uppercase drop-shadow-[0_0_5px_rgba(255,215,0,0.5)]">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-amber-100/80">
          <li><a href="/" class="transition-colors hover:text-yellow-400">> หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-yellow-400">> โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-yellow-400">> สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-yellow-400">> เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-yellow-400 uppercase drop-shadow-[0_0_5px_rgba(255,215,0,0.5)]">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        <div class="mt-2 font-mono text-xs text-amber-400">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-amber-500/30 pt-6 font-mono text-xs text-amber-200/40 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} PABLO666</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="hover:text-yellow-400">TERMS_OF_SERVICE</a>
        <a href="/" class="hover:text-yellow-400">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
