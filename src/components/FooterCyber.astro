---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-lime-400/50 bg-[#04120a] pt-16 pb-8 font-sans text-white"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(#22c55e 1px, transparent 1px), linear-gradient(90deg, #a3e635 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="PGZEED168 โลโก้" class="h-[60px] w-auto drop-shadow-[0_0_15px_rgba(163,230,53,0.5)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="text-3xl font-black tracking-widest text-lime-400">PGZEED168</p>
            )
          }
        </a>
        <p class="border-l-2 border-lime-400 pl-4 text-sm leading-relaxed text-lime-100/70">
          PGZEED168 สล็อตเกมยอดนิยม เชื่อมต่อระบบ API แท้ไม่ล็อคยูสเซอร์ รวมสล็อต คาสิโนสด ยิงปลา และเกมโต๊ะไว้ในบัญชีเดียว โบนัสเข้าง่าย ฝากถอนออโต้ด้วย AI อัจฉริยะ มั่นคง ปลอดภัย
          รองรับทุกอุปกรณ์
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-green-500/30 bg-green-900/40 px-3 py-1 font-mono text-xs text-green-300">AUTO_SYSTEM</span>
          <span class="border border-lime-400/30 bg-lime-900/40 px-3 py-1 font-mono text-xs text-lime-300">100%_SECURE</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-lime-300 uppercase drop-shadow-[0_0_5px_rgba(163,230,53,0.5)]">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-lime-100/80">
          <li><a href="/" class="transition-colors hover:text-lime-300">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-lime-300">&gt; โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-lime-300">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-lime-300">&gt; ทางเข้า</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-lime-300">&gt; ติดต่อเรา</a></li>
          <li><a href="/register" class="transition-colors hover:text-lime-300">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-lime-300">&gt; เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-lime-300 uppercase drop-shadow-[0_0_5px_rgba(163,230,53,0.5)]">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        <div class="mt-2 font-mono text-xs text-lime-400">ACCEPTED_PAYMENTS</div>
        <div class="flex flex-wrap gap-2 opacity-80">
          <div class="flex h-6 w-10 items-center justify-center border border-white/10 bg-[#118A44] text-[10px] font-bold text-white shadow-sm" title="KBank">KB</div>
          <div class="flex h-6 w-10 items-center justify-center border border-white/10 bg-[#4E2B7A] text-[10px] font-bold text-white shadow-sm" title="SCB">SCB</div>
          <div class="flex h-6 w-10 items-center justify-center border border-white/10 bg-[#1BA1E2] text-[10px] font-bold text-white shadow-sm" title="KTB">KTB</div>
          <div class="flex h-6 w-10 items-center justify-center border border-white/10 bg-[#1E4598] text-[10px] font-bold text-white shadow-sm" title="Bangkok Bank">BBL</div>
          <div class="flex h-6 w-10 items-center justify-center border border-white/10 bg-[#FEC400] text-[10px] font-bold text-[#1E4598] shadow-sm" title="Krungsri">BAY</div>
          <div
            class="flex h-6 w-10 items-center justify-center border border-white/10 bg-gradient-to-r from-orange-500 to-orange-400 text-[10px] font-bold text-white shadow-sm"
            title="TrueMoney Wallet">
            TW
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-lime-400/30 pt-6 font-mono text-xs text-lime-200/40 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} PGZEED168</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="hover:text-lime-300">TERMS_OF_SERVICE</a>
        <a href="/" class="hover:text-lime-300">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
