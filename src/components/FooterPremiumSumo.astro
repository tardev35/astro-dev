---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-amber-500/60 bg-[#04170d] pt-16 pb-8 font-sans text-white shadow-[0_-15px_40px_rgba(16,185,129,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-emerald-600/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-amber-500/30 bg-[#062b16] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="EZWIN168 โลโก้เว็บสล็อตออนไลน์" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="text-3xl font-black tracking-widest text-white">
                EZ<span class="text-amber-400">WIN168</span>
              </p>
            )
          }
        </a>
        <p class="border-l-2 border-amber-500/50 pl-4 text-sm leading-relaxed text-emerald-100/70">
          EZWIN168 แพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมหลายรูปแบบ พร้อมระบบฝากถอนออโต้ โปรทุนน้อย และสิทธิ์คืนยอดเสียตามเงื่อนไขที่เว็บไซต์กำหนด สมาชิกควรอ่านรายละเอียดโปรโมชั่นและข้อกำหนดการถอนก่อนใช้งาน
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-emerald-400/30 bg-emerald-900/30 px-4 py-1 text-xs font-medium text-emerald-300 backdrop-blur-sm">ฝากถอนออโต้</span>
          <span class="rounded-full border border-amber-500/30 bg-amber-900/20 px-4 py-1 text-xs font-medium text-amber-400 backdrop-blur-sm">คืนยอดเสีย</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-amber-500"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-emerald-100/70">
          <li><a href="/" class="transition-colors hover:text-amber-400">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-amber-400">โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-amber-400">ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-amber-400">ทางเข้าเล่น</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-amber-400">ติดต่อเรา</a></li>
          <li><a href="/register" class="transition-colors hover:text-amber-400">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-amber-400">เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-amber-500"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        <div class="mt-4 text-xs font-medium tracking-widest text-emerald-200/50 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-emerald-900/60 pt-8 text-xs font-medium tracking-wide text-emerald-200/50 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} EZWIN168SS.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-amber-400">เงื่อนไขข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-amber-400">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
