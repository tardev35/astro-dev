---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-32 w-full border-t border-amber-500/25 bg-[#0a0604] pt-64 pb-6 font-sans text-white shadow-[0_-10px_30px_rgba(245,158,11,0.12)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-amber-400/40 bg-gradient-to-r from-[#2a0a06] via-[#7f1d1d] to-[#b45309] p-6 shadow-[0_15px_40px_rgba(245,158,11,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">🔥 พร้อมลุย KINGHENG168 แล้วหรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-amber-100/90 md:text-base">สมัครสมาชิกใหม่ KINGHENG168 วันนี้ รับโบนัสเพิ่มทันที รวมค่ายลิขสิทธิ์แท้ครบในเว็บเดียว ฝาก-ถอนออโต้ ไม่ล็อคยูสเซอร์!</p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-amber-300 bg-gradient-to-b from-[#fde68a] to-[#d97706] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a1206] shadow-[0_0_15px_rgba(245,158,11,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย 🚀</span>
      <div class="absolute inset-0 translate-y-full bg-[#fcd34d] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="KINGHENG168 Logo" class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(245,158,11,0.55)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="bg-gradient-to-b from-[#fef3c7] to-[#d97706] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]">KINGHENG168</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-gray-400">
          KINGHENG168 สล็อตทำเงินง่ายรายได้ดี แตกง่ายจ่ายจริง ฝากถอนไว รวมค่ายลิขสิทธิ์แท้ระดับโลก PG Soft, Pragmatic Play, JILI และ Habanero เชื่อมต่อผ่าน API แท้ ไม่ล็อคยูสเซอร์ ระบบลื่นไหลเสถียร
          ฝาก-ถอนออโต้ด้วย AI อัจฉริยะ จ่ายเต็ม 100%
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span class="text-base">💬</span> LINE OFFICIAL
          </a>
          <a
            href="#"
            class="flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-xs font-bold text-amber-400 shadow-[0_0_10px_rgba(245,158,11,0.12)] transition-colors hover:bg-amber-500 hover:text-[#1a1206]">
            <span class="text-base">📍</span> YOUTUBE
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b45309] to-[#fbbf24] shadow-[0_0_8px_rgba(245,158,11,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อตฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิกใหม่
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> ทางเข้าเล่นล่าสุด
          </a>
          <a href="/บทความ" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> บทความสล็อต
          </a>
          <a href="/about-us" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> เกี่ยวกับเรา
          </a>
          <a href="/register" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/contact-us" class="group flex items-center text-gray-400 transition-colors hover:text-[#fbbf24]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d97706] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b45309] to-[#fbbf24] shadow-[0_0_8px_rgba(245,158,11,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-gray-400">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำ, TrueMoney Wallet และระบบ Cryptocurrency ประมวลผลอัตโนมัติในเสี้ยววินาที</p>

        <div class="grid grid-cols-3 gap-2">
          <div class="flex h-10 items-center justify-center rounded border border-white/5 bg-[#14040a] transition-colors hover:border-[#fbbf24]/50" title="True Wallet">
            <span class="text-xs font-black text-orange-500 italic">TRUE<span class="text-white">WALLET</span></span>
          </div>
          <div class="flex h-10 items-center justify-center rounded border border-white/5 bg-[#14040a] transition-colors hover:border-[#fbbf24]/50" title="KBank">
            <span class="text-lg font-black text-green-500">K<span class="text-xs text-white">BANK</span></span>
          </div>
          <div class="flex h-10 items-center justify-center rounded border border-white/5 bg-[#14040a] transition-colors hover:border-[#fbbf24]/50" title="SCB">
            <span class="text-lg font-black text-purple-500">S<span class="text-xs text-white">CB</span></span>
          </div>
          <div class="col-span-3 mt-1 flex h-10 items-center justify-center rounded border border-white/5 bg-[#14040a] transition-colors hover:border-[#fbbf24]/50" title="USDT Crypto">
            <span class="flex items-center gap-1 text-xs font-bold text-gray-300"><span class="text-lg text-green-400">₮</span> รองรับ USDT (TRC20)</span>
          </div>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-amber-900/40" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-gray-600 md:block">
      สล็อตเว็บตรง สล็อตแตกง่าย สล็อตออนไลน์ เล่นสล็อตฟรี pg slot ทางเข้า คาสิโนออนไลน์ บาคาร่าออนไลน์ แทงบอล สล็อตวอเลท ฝากถอนไม่มีขั้นต่ำ สล็อตเว็บตรงไม่ผ่านเอเย่นต์ เว็บพนันออนไลน์ เว็บสล็อตแตกบ่อย
      เกมสล็อตมือถือ ทดลองเล่นสล็อต pg เว็บตรงสล็อต คาสิโนสด รูเล็ต ไฮโล สล็อตทดลองเล่น เครดิตฟรี สล็อตpgแท้ โปรสล็อตทุนน้อย KINGHENG168
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-gray-500 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-amber-400 uppercase">KINGHENG168</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-white transition-all hover:border-[#fbbf24] hover:bg-[#b45309] hover:shadow-[0_0_15px_rgba(245,158,11,0.6)]"
          aria-label="Back to top">
          ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: "Kanit", sans-serif;
  }
</style>
