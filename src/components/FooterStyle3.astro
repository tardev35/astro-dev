---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-32 w-full border-t border-amber-800/30 bg-[#050308] pt-64 pb-6 font-sans text-white shadow-[0_-10px_30px_rgba(212,162,74,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-amber-400/30 bg-gradient-to-r from-[#2e1065] via-[#4c1d95] to-[#7c3aed] p-6 shadow-[0_15px_40px_rgba(124,58,237,0.4)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">🎁 พร้อมเปิดกล่องกับ PAY69 แล้วหรือยัง?</p>
      <p class="mt-2 text-sm font-medium text-violet-100/90 md:text-base">สมัคร PAY69 วันนี้ ครบทั้งสล็อต กีฬา เกมไลฟ์สด และกิจกรรมล่ารางวัล อ่านเงื่อนไขก่อนกดรับสิทธิ์ทุกครั้ง</p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-amber-300 bg-gradient-to-b from-[#f7e3bd] to-[#b8823a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a1130] shadow-[0_0_15px_rgba(212,162,74,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย 🚀</span>
      <div class="absolute inset-0 translate-y-full bg-[#f2dbb4] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="PAY69 Logo" class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(212,162,74,0.6)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <p class="bg-gradient-to-b from-[#f7e3bd] to-[#b8823a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(212,162,74,0.5)]">PAY69</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-gray-400">
          PAY69 รวมสล็อต กีฬา เกม Live สด และเดิมพันด้านการเงินไว้ในระบบเดียว พร้อมกิจกรรมเปิดกล่อง เปิดดวง ล่า Hidden เครดิตฟรีกดรับเอง และแอปมือถือที่ใช้สมัคร เข้าระบบ และติดตามกิจกรรมได้ครบ
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span class="text-base">💬</span> LINE OFFICIAL
          </a>
          <a
            href="#"
            class="flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-600/10 px-4 py-2 text-xs font-bold text-violet-300 shadow-[0_0_10px_rgba(124,58,237,0.15)] transition-colors hover:bg-violet-600 hover:text-white">
            <span class="text-base">📍</span> YOUTUBE
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8823a] to-[#f2dbb4] shadow-[0_0_8px_rgba(212,162,74,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <a href="/" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> หน้าแรก
          </a>
          <a href="/ทดลองเล่น" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> ทดลองเล่นสล็อตฟรี
          </a>
          <a href="/promotion" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> โปรโมชั่นสมาชิกใหม่
          </a>
          <a href="/ทางเข้า" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> ทางเข้าเล่นล่าสุด
          </a>
          <a href="/register" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> สมัครสมาชิก
          </a>
          <a href="/contact-us" class="group flex items-center text-gray-400 transition-colors hover:text-[#f2dbb4]">
            <span class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#d4a24a] transition-transform group-hover:rotate-45"></span> ติดต่อแอดมิน
          </a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8823a] to-[#f2dbb4] shadow-[0_0_8px_rgba(212,162,74,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-gray-400">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำ, TrueMoney Wallet และระบบ Cryptocurrency</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#150a24] transition-colors hover:border-[#d4a24a]/50" title="USDT Crypto">
          <span class="flex items-center gap-1 text-xs font-bold text-gray-300"><span class="text-lg text-green-400">₮</span> รองรับ USDT (TRC20)</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-amber-800/30" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-gray-600 md:block">
      สล็อตออนไลน์ เกมสล็อตมือถือ ทดลองเล่นสล็อต แทงบอลออนไลน์ ค่าน้ำบอล ราคาบอลไหล เกมไลฟ์สด บาคาร่าออนไลน์ รูเล็ต ไฮโล เดิมพันด้านการเงิน กิจกรรมเปิดกล่อง เปิดดวง ล่า Hidden เครดิตฟรีกดรับเอง ฝากเพิ่ม
      5% ถอนไม่จำกัด แอปเดิมพันมือถือ ทางเข้าเล่นล่าสุด สมัครสมาชิกใหม่ PAY69
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-gray-500 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-amber-300 uppercase">PAY69</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-white transition-all hover:border-[#f2dbb4] hover:bg-[#7c3aed] hover:shadow-[0_0_15px_rgba(124,58,237,0.6)]"
          aria-label="Back to top">
          ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
