---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "Mahjong Ways 2", type: "PG Soft • สล็อตยอดนิยม", rtp: 98.7, players: 5124, img: img1 },
  { rank: 2, name: "Gates of Olympus", type: "Pragmatic Play • สล็อตแตกหนัก", rtp: 97.9, players: 3842, img: img2 },
  { rank: 3, name: "Sweet Bonanza", type: "Pragmatic Play • ซื้อฟรีสปิน", rtp: 97.6, players: 3517, img: img3 },
  { rank: 4, name: "Fortune Tiger", type: "PG Soft • สล็อตคลาสสิก", rtp: 97.2, players: 2905, img: img4 },
  { rank: 5, name: "Sugar Rush", type: "Pragmatic Play • คลัสเตอร์เพย์", rtp: 96.8, players: 2431, img: img5 },
  { rank: 6, name: "Mahjong Ways", type: "PG Soft • สล็อตยอดนิยม", rtp: 96.5, players: 2108, img: img6 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span class="text-2xl drop-shadow-[0_0_10px_rgba(245,158,11,0.7)]">🏆</span>
    <p class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      จัดอันดับเกม RTP สูงสุดประจำสัปดาห์
    </p>
    <p class="max-w-2xl text-sm text-red-50/60">ข้อมูลค่า RTP โดยประมาณจากการวิเคราะห์ค่ายเกม เพื่อประกอบการตัดสินใจเลือกเกมของผู้เริ่มต้น</p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-amber-400/50 bg-gradient-to-r from-[#1c060c]/90 via-[#14040a]/90 to-[#14040a]/90 shadow-[0_10px_30px_rgba(245,158,11,0.15)]"
                : "border-red-500/25 bg-[#14040a]/80 shadow-[0_5px_20px_rgba(0,0,0,0.4)] hover:border-red-400/50 hover:shadow-[0_10px_30px_rgba(220,38,38,0.25)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-red-500/10 blur-[40px] transition-all duration-500 group-hover:bg-red-400/20" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl drop-shadow-[0_0_8px_rgba(245,158,11,0.5)] sm:text-3xl">{medal(g.rank)}</span>
              ) : (
                <span class="text-xl font-black text-red-300/70 sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div
              class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${
                top ? "border-amber-400/50" : "border-red-500/30"
              }`}>
              <Picture
                src={g.img}
                alt={g.name}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-white sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-amber-400/40 bg-amber-400/10 px-2 py-0.5 text-[9px] font-black tracking-wider text-amber-300 sm:inline">TOP RTP</span>}
              </div>
              <p class="truncate text-[11px] text-red-50/50 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex items-center gap-2">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-[#0d0304]">
                  <div
                    class={`h-full rounded-full ${top ? "bg-gradient-to-r from-amber-300 to-amber-500" : "bg-gradient-to-r from-red-600 to-amber-400"}`}
                    style={`width:${g.rtp}%`}
                  />
                </div>
                <span class={`shrink-0 text-xs font-black tabular-nums ${top ? "text-amber-300" : "text-red-200"}`}>{g.rtp}%</span>
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-red-50/50">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-red-500 via-red-600 to-red-700 text-white shadow-[0_4px_15px_rgba(220,38,38,0.45)]"
                    : "border border-red-500/50 bg-red-950/40 text-red-200 hover:border-amber-400 hover:text-white"
                }`}>
                เล่นเลย
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>

<script>
  const nf = new Intl.NumberFormat("en-US");

  document.querySelectorAll<HTMLElement>("[data-players]").forEach((el) => {
    const base = Number(el.dataset.base) || 0;
    let current = base;

    const tick = () => {
      const drift = Math.round((Math.random() - 0.5) * base * 0.02);
      const pull = Math.round((base - current) * 0.15);
      current = Math.max(1, current + drift + pull);
      el.textContent = nf.format(current);

      setTimeout(tick, 1500 + Math.random() * 2000);
    };

    setTimeout(tick, Math.random() * 2000);
  });
</script>
