---
const providers = [
  { name: "PG Soft", desc: "กราฟิก 3D ฟีเจอร์ล้ำสมัย", tag: "HOT 🔥", color: "from-[#0e3486] to-[#04102e]" },
  { name: "Pragmatic Play", desc: "มีโหมดซื้อฟรีสปิน", tag: "HIT ⭐", color: "from-[#07215f] to-[#04102e]" },
  { name: "JILI", desc: "เอฟเฟกต์จัดจ้าน รองรับทุกอุปกรณ์", tag: "POPULAR", color: "from-[#1246b0] to-[#04102e]" },
  { name: "Habanero", desc: "สล็อตคลาสสิกอ่านกติกาง่าย", tag: "RECOMMEND", color: "from-[#0e3486] to-[#07215f]" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายฟีเจอร์พิเศษ", tag: "NEW 🌟", color: "from-[#07215f] to-[#04102e]" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ความผันผวนสูง", tag: "VIP 💎", color: "from-[#1246b0] to-[#07215f]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-3xl font-black tracking-wide text-transparent drop-shadow-[0_2px_10px_rgba(251,191,36,0.35)]">
      ค่ายเกมและเกมยอดนิยมของ <span class="text-amber-300">PORING168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <a
          href="/register"
          aria-label={`เข้าเล่นเกม ${game.name}`}
          class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-400/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-300 hover:shadow-[0_10px_30px_rgba(251,191,36,0.4)]`}>
          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04102e] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(251,191,36,0.45)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            🎰
          </div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-amber-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-blue-50/70 group-hover:text-white">{game.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-amber-400/40 bg-black/40 py-1.5 text-center text-[11px] font-bold text-amber-300 shadow-inner transition-colors duration-300 group-hover:border-amber-300 group-hover:bg-gradient-to-r group-hover:from-amber-300 group-hover:to-blue-500 group-hover:text-[#04102e]">
            เข้าเล่นเกม
          </span>
        </a>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
