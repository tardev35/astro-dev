---
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-[#0a2a13] to-[#03110a]" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-[#123010] to-[#040f07]" },
  { name: "JILI", desc: "เกมยอดฮิตครบวงจร", tag: "POPULAR", color: "from-[#16330c] to-black" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-[#08301b] to-[#02120b]" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายแตกหนัก", tag: "NEW 🌟", color: "from-[#0d2e18] to-[#03110a]" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ลุ้นรางวัลใหญ่", tag: "VIP 💎", color: "from-[#1a3a0c] to-[#04120a]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-white via-lime-200 to-lime-400 bg-clip-text text-3xl font-black tracking-wide text-transparent drop-shadow-[0_2px_10px_rgba(163,230,53,0.35)]">
      ค่ายดังและเกมยอดนิยม <span class="text-lime-300">PGZEED168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-lime-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-lime-400/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-lime-300 hover:shadow-[0_10px_30px_rgba(163,230,53,0.4)]`}>

          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-lime-300 to-lime-500 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04120a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(163,230,53,0.45)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">🎰</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-lime-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-lime-50/70 group-hover:text-white">{game.desc}</p>

          <div class="mt-4 w-full rounded-full border border-lime-400/40 bg-black/40 py-1.5 text-center text-[11px] font-bold text-lime-300 shadow-inner transition-colors duration-300 group-hover:border-lime-300 group-hover:bg-gradient-to-r group-hover:from-lime-400 group-hover:to-green-600 group-hover:text-[#04120a]">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
