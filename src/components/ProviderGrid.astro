---
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-red-700 to-red-950" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-red-600 to-red-900" },
  { name: "JILI", desc: "เกมยอดฮิตครบวงจร", tag: "POPULAR", color: "from-red-800 to-black" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-red-700 to-[#1c060c]" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายแตกหนัก", tag: "NEW 🌟", color: "from-red-900 to-[#0d0304]" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ลุ้นรางวัลใหญ่", tag: "VIP 💎", color: "from-red-600 to-red-800" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-amber-200 via-amber-400 to-red-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(220,38,38,0.35)]">
      ค่ายดังและเกมยอดนิยม <span class="text-amber-300">CASHOT123</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-red-500/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(220,38,38,0.45)]`}>

          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-black shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">🎰</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-amber-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-red-100/70 group-hover:text-white">{game.desc}</p>

          <div class="mt-4 w-full rounded-full border border-amber-500/30 bg-black/40 py-1.5 text-center text-[11px] font-bold text-amber-300 shadow-inner transition-colors duration-300 group-hover:border-amber-300 group-hover:bg-red-600 group-hover:text-white">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
