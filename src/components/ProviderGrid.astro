---
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-blue-700 to-[#040b1e]" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-blue-600 to-[#071433]" },
  { name: "JILI", desc: "เกมยอดฮิตครบวงจร", tag: "POPULAR", color: "from-blue-800 to-[#040b1e]" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-red-800 to-[#071433]" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายแตกหนัก", tag: "NEW 🌟", color: "from-blue-900 to-[#040b1e]" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ลุ้นรางวัลใหญ่", tag: "VIP 💎", color: "from-[#0a1a3d] to-[#040b1e]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-blue-400 via-white to-blue-300 bg-clip-text text-2xl font-black tracking-wide text-transparent drop-shadow-[0_2px_10px_rgba(37,99,235,0.4)] md:text-3xl">
      ค่ายดังและเกมยอดนิยม <span class="text-yellow-300">LONDON999VIP</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div
          class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-blue-500/25 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-blue-400 hover:shadow-[0_10px_30px_rgba(37,99,235,0.4)]`}>
          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-yellow-300 to-yellow-500 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#040b1e] uppercase shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">🎰</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-blue-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-blue-100/60 group-hover:text-white">{game.desc}</p>

          <div class="mt-4 w-full rounded-full border border-blue-500/40 bg-[#040b1e]/60 py-1.5 text-center text-[11px] font-bold text-blue-300 shadow-inner transition-colors duration-300 group-hover:border-red-400 group-hover:bg-red-600 group-hover:text-white">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
