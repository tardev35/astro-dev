---
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-amber-600 to-[#141008]" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-slate-500 to-[#0b1120]" },
  { name: "JILI", desc: "เกมยอดฮิตครบวงจร", tag: "POPULAR", color: "from-amber-700 to-[#060a14]" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-slate-600 to-[#0b1120]" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายแตกหนัก", tag: "NEW 🌟", color: "from-amber-500 to-[#141008]" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ลุ้นรางวัลใหญ่", tag: "VIP 💎", color: "from-slate-400 to-[#0b1120]" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="bg-gradient-to-r from-slate-100 via-slate-300 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_2px_10px_rgba(203,213,225,0.2)]">
      ค่ายดังและเกมยอดนิยม <span class="text-amber-400">NOVA852</span>
    </h2>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div
          class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-500/20 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(251,191,36,0.4)]`}>
          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-yellow-300 to-amber-500 px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0b1120] uppercase shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="mb-3 text-4xl drop-shadow-[0_0_15px_rgba(203,213,225,0.35)] transition-transform duration-300 group-hover:rotate-3 group-hover:scale-125">🎰</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-amber-300">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-slate-300 group-hover:text-white">{game.desc}</p>

          <div class="mt-4 w-full rounded-full border border-amber-500/30 bg-[#060a14]/60 py-1.5 text-center text-[11px] font-bold text-amber-400 shadow-inner transition-colors duration-300 group-hover:border-amber-300 group-hover:bg-amber-500 group-hover:text-[#0b1120]">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
