---
const providers = [
  { name: "PG Soft", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-amber-600 to-amber-900" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-amber-500 to-amber-800" },
  { name: "JILI", desc: "เกมยอดฮิตครบวงจร", tag: "POPULAR", color: "from-amber-700 to-black" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-yellow-600 to-amber-800" },
  { name: "Mahjong Ways", desc: "เกมยอดนิยมสายแตกหนัก", tag: "NEW 🌟", color: "from-amber-800 to-gray-900" },
  { name: "Gates of Olympus", desc: "ตัวคูณสูง ลุ้นรางวัลใหญ่", tag: "VIP 💎", color: "from-amber-600 to-amber-800" },
];
---

<div class="mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans relative z-10">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="text-3xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-amber-800 via-yellow-600 to-yellow-300 drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]">
      ค่ายดังและเกมยอดนิยม <span class="text-amber-400">PABLO666</span>
    </h2>
    <div class="h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-500 to-transparent mt-2"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-500/20 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:shadow-[0_10px_30px_rgba(234,179,8,0.4)]`}>

          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="absolute right-2 top-2 z-10 whitespace-nowrap rounded-full bg-gradient-to-r from-yellow-400 to-yellow-600 px-2 py-0.5 text-[9px] font-black uppercase tracking-wide text-black shadow-sm transition-transform duration-300 group-hover:scale-110">
            {game.tag}
          </div>

          <div class="text-4xl mb-3 drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">🎰</div>
          <p class="text-center text-sm font-black text-white transition-colors group-hover:text-yellow-400">{game.name}</p>
          <p class="mt-1 text-center text-[10px] text-gray-300 group-hover:text-white">{game.desc}</p>

          <div class="mt-4 w-full rounded-full bg-black/40 py-1.5 text-center text-[11px] font-bold text-amber-400 shadow-inner border border-amber-500/30 transition-colors duration-300 group-hover:bg-amber-600 group-hover:text-white group-hover:border-amber-400">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
