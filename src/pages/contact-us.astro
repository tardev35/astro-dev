---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อ LONDON999VIP ทีมแอดมินระดับ VIP ดูแล 24 ชั่วโมง",
  description: "ช่องทางติดต่อทีมงาน LONDON999VIP รวมค่ายเกมสล็อตยอดฮิต มั่นคงปลอดภัย ฝากถอนไวอัตโนมัติ พร้อมซัพพอร์ตทุกข้อสงสัยตลอด 24 ชั่วโมง",
  url: currentPath,
  mainEntity: {
    "@type": "Organization",
    name: "LONDON999VIP",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: "https://tinyurl.com/linepigpg",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout title="ติดต่อ LONDON999VIP | ทีมแอดมินระดับ VIP สแตนด์บายดูแล 24 ชม." description="หากพบปัญหาขัดข้องหรือต้องการคำแนะนำ ทีมงานมืออาชีพของ LONDON999VIP พร้อมสแตนด์บายซัพพอร์ตและแก้ไขทุกข้อสงสัยให้คุณอย่างรวดเร็วตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox>
    <h1 class="mb-8 bg-gradient-to-r from-white via-blue-200 to-blue-400 bg-clip-text text-3xl font-black tracking-wide text-transparent drop-shadow-sm">ติดต่อ LONDON999VIP ทีมแอดมิน VIP ดูแลตลอด 24 ชม.</h1>
    <Picture
      src={imgLine}
      alt="ติดต่อแอดมิน LONDON999VIP ผ่าน LINE Official ตลอด 24 ชั่วโมง"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 mb-8 text-blue-100/90">
      ทีมงาน LONDON999VIP สแตนด์บายดูแลคุณตลอด 24 ชั่วโมง ทั้งเรื่องสมัครสมาชิก ฝากถอนอัตโนมัติ การรับโปรโมชั่น และทุกข้อสงสัยเกี่ยวกับการใช้งาน ทักหาแอดมินได้ทันทีผ่าน LINE Official ตอบไวไม่ต้องรอคิว
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-red-400/70 bg-gradient-to-b from-red-500 to-red-800 px-8 py-3 font-bold text-white shadow-[0_0_15px_rgba(220,38,38,0.4)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-blue-300 bg-gradient-to-b from-blue-500 to-blue-800 px-8 py-3 font-extrabold text-white shadow-[0_0_15px_rgba(37,99,235,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
