---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "PORING168 ติดต่อเรา บริการฉับไว แอด LINE ทีมงานดูแล 24 ชม.",
  description: "ช่องทางการติดต่อ PORING168 ทีมงานมืออาชีพพร้อมตอบสนองอย่างรวดเร็วและคล่องตัว แอด LINE เพื่อรับคำแนะนำหรือแจ้งปัญหาได้ตลอด 24 ชั่วโมง",
  url: homePage + currentPath,
  mainEntity: {
    "@type": "Organization",
    name: "PORING168",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: homePage + "/line",
        description: "ติดต่อทีมงานผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="PORING168 ติดต่อเรา บริการฉับไว แอด LINE ทีมงานดูแล 24 ชม."
  description="ช่องทางการติดต่อ PORING168 ทีมงานมืออาชีพพร้อมตอบสนองอย่างรวดเร็วและคล่องตัว แอด LINE เพื่อรับคำแนะนำหรือแจ้งปัญหาได้ตลอด 24 ชั่วโมง ไม่มีวันหยุด">
  <Announcement />

  <ContentBox title="PORING168 ติดต่อเรา บริการฉับไว แอด LINE ทีมงานดูแล 24 ชม.">
    <Picture
      src={imgLine}
      alt="ติดต่อทีมงาน PORING168 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="mt-5 mb-8 text-left text-base leading-relaxed">
      หากพบปัญหาเกี่ยวกับการเข้าสู่ระบบ การรับสิทธิ์โปรโมชั่น หรือสถานะฝากถอน สามารถแอด LINE ติดต่อทีมงาน PORING168 ได้ตลอด 24 ชั่วโมง ไม่มีวันหยุด ทีมงานพร้อมตอบสนองอย่างรวดเร็วและคล่องตัว
      ควรเตรียมชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดรายการให้ครบ พร้อมเก็บหลักฐานการทำรายการไว้จนกว่าจะเสร็จสมบูรณ์ ทั้งนี้ไม่ควรเปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้อื่น
      และควรทำรายการผ่านบัญชีธนาคารที่ตรงกับข้อมูลที่ใช้สมัครเท่านั้น
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-amber-300 bg-gradient-to-b from-amber-300 to-amber-500 px-8 py-3 font-extrabold text-[#04102e] shadow-[0_0_15px_rgba(251,191,36,0.55)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-blue-500 bg-gradient-to-b from-blue-600 to-blue-900 px-8 py-3 font-bold text-white shadow-[0_0_15px_rgba(37,99,235,0.45)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-[#00B900] bg-gradient-to-b from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
