---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อ PGZEED168 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง",
  description: "ติดต่อ PGZEED168 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง",
  url: currentPath,
  mainEntity: {
    "@type": "Organization",
    name: "PGZEED168",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout
  title="ติดต่อ EZWIN168 | สอบถามบัญชีและธุรกรรมตลอด 24 ชั่วโมง" description="ติดต่อทีมงาน EZWIN168 เพื่อสอบถามเรื่องบัญชี โปรโมชั่นคืนยอดเสีย การเข้าสู่ระบบ และสถานะฝากถอน พร้อมให้คำแนะนำตลอด 24 ชั่วโมง">
  <Announcement />

  <ContentBox title="ติดต่อ PGZEED168 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง">
    <Picture
      src={imgLine}
      alt="ติดต่อแอดมิน PGZEED168 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="mt-5 mb-8 text-left text-base leading-relaxed">
      หากพบปัญหาขัดข้องหรือต้องการคำแนะนำ ทีมงานมืออาชีพของ PGZEED168 พร้อมสแตนด์บายซัพพอร์ตและแก้ไขทุกข้อสงสัยให้คุณอย่างรวดเร็วตลอด 24 ชั่วโมง ดูแลครบทุกขั้นตอนตั้งแต่สมัครเปิดยูสเซอร์ใหม่
      การกดรับโปรโมชั่น ฝากถอนออโต้ที่ประมวลผลด้วย AI อัจฉริยะ ไปจนถึงการเข้าเล่นสล็อตเกมยอดนิยมผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์ ทุกยอดถอนการันตีจ่ายเต็ม 100%
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-lime-300 bg-gradient-to-b from-lime-300 to-lime-500 px-8 py-3 font-extrabold text-[#0a1a0e] shadow-[0_0_15px_rgba(163,230,53,0.55)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-green-500 bg-gradient-to-b from-green-600 to-green-900 px-8 py-3 font-bold text-white shadow-[0_0_15px_rgba(34,197,94,0.45)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-[#00B900] bg-gradient-to-b from-[#00B900] to-[#009900] px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
