---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "ติดต่อ ดีเฮง789 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง",
  description: "ติดต่อ ดีเฮง789 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง",
  url: currentPath,
  mainEntity: {
    "@type": "Organization",
    name: "ดีเฮง789",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: homePage + "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout title="PORING168 ติดต่อเรา บริการฉับไว แอด LINE ทีมงานดูแล 24 ชม." description="ช่องทางการติดต่อ PORING168 ทีมงานมืออาชีพพร้อมตอบสนองอย่างรวดเร็วและคล่องตัว แอด LINE เพื่อรับคำแนะนำหรือแจ้งปัญหาได้ตลอด 24 ชั่วโมง ไม่มีวันหยุด">
  <Announcement />

  <ContentBox>
    <h1 class="mb-8 bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text text-3xl font-black text-transparent">ติดต่อ ดีเฮง789 ทีมแอดมินมืออาชีพ ดูแลตลอด 24 ชั่วโมง</h1>
    <Picture
      src={imgLine}
      alt="ติดต่อแอดมิน ดีเฮง789 ผ่าน LINE Official"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 mb-8 text-red-50/85">หากพบปัญหาขัดข้องหรือต้องการคำแนะนำ ทีมงานมืออาชีพของ ดีเฮง789 พร้อมสแตนด์บายซัพพอร์ตและแก้ไขทุกข้อสงสัยให้คุณอย่างรวดเร็วตลอด 24 ชั่วโมง ดูแลครบทุกขั้นตอนตั้งแต่สมัครสมาชิก ฝากถอนสะดวกด้วยระบบออโต้ ไปจนถึงการเข้าเล่นเกมผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-red-400 bg-gradient-to-b from-red-500 to-red-800 px-8 py-3 font-bold text-white shadow-[0_0_15px_rgba(220,38,38,0.45)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-amber-600 bg-gradient-to-b from-amber-300 to-amber-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(251,191,36,0.5)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
