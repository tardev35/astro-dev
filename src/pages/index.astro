---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement3 from "../components/Announcement3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import imgGameVariety from "../assets/slide2.png";
import imgLowBudgetPromo from "../assets/slide3.png";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "EZWIN168 | เว็บมั่นคงสล็อตออนไลน์ โปรทุนน้อยคืนยอดเสีย จ่ายทุกบิล";
const pageDescription =
  "EZWIN168 เว็บสล็อตออนไลน์ที่เน้นระบบใช้งานง่ายสะดวก มาพร้อมกับโปรทุนน้อย คืนยอดเสียตามเงื่อนไข ฝากถอนออโต้ รองรับมือถือทุกระบบ";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "EZWIN168",
  description: pageDescription,
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "EZWIN168",
  alternateName: ["EZWIN168", "EZWIN168 เว็บมั่นคงสล็อตออนไลน์ โปรทุนน้อยคืนยอดเสีย จ่ายทุกบิล"],
  url: "https://ezwin168ss.com",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "EZWIN168",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

const supportPoints = [
  {
    icon: "🔐",
    title: "แจ้งปัญหาการเข้าสู่ระบบ",
    description: "หากเข้าใช้งานบัญชีไม่ได้ ควรแจ้งชื่อผู้ใช้และเวลาที่พบปัญหาผ่านช่องทางที่เว็บไซต์กำหนด และไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้อื่นในทุกกรณี",
    accent: "gold" as const,
  },
  {
    icon: "🎁",
    title: "สอบถามสิทธิ์คืนยอดเสีย",
    description: "ตรวจสอบรอบการคำนวณ อัตราคืน ยอดสูงสุด และเกมที่ร่วมรายการกับทีมงานก่อนรับสิทธิ์ เพื่อให้ตรงกับเงื่อนไขของโปรโมชั่นที่เลือกใช้",
    accent: "emerald" as const,
  },
  {
    icon: "💳",
    title: "ติดตามสถานะฝากถอน",
    description: "เตรียมรายละเอียดรายการ เวลาที่ทำธุรกรรม และหลักฐานการโอนให้ครบถ้วน จะช่วยให้ทีมงานตรวจสอบสถานะและชี้แจงขั้นตอนถัดไปได้รวดเร็วขึ้น",
    accent: "gold" as const,
  },
  {
    icon: "🕑",
    title: "ใช้ช่องทางหลักของเว็บไซต์",
    description: "ติดต่อผ่านช่องทางที่ EZWIN168 ประกาศไว้เท่านั้น เพื่อลดความเสี่ยงจากการส่งข้อมูลบัญชีให้ช่องทางที่ไม่ได้รับการยืนยัน",
    accent: "emerald" as const,
  },
];

const faqs = [
  {
    q: "โปรโมชั่นทุนน้อยของ EZWIN168 เหมาะกับใคร?",
    a: "เหมาะกับผู้ที่ต้องการเริ่มต้นด้วยงบประมาณจำกัด แต่ควรตรวจสอบยอดฝากขั้นต่ำ เงื่อนไขการทำรายการ เกมที่เข้าร่วม และข้อกำหนดการถอนก่อนรับสิทธิ์",
  },
  {
    q: "EZWIN168 คืนยอดเสียอย่างไร?",
    a: "การคืนยอดเสียมักคำนวณจากยอดขาดทุนสุทธิในช่วงเวลาที่กำหนด โดยอัตราคืนและยอดสูงสุดขึ้นอยู่กับเงื่อนไขของแต่ละโปรโมชั่น",
  },
  {
    q: "EZWIN168 จ่ายทุกบิลจริงหรือไม่?",
    a: "การอนุมัติรายการขึ้นอยู่กับยอดคงเหลือ สถานะบัญชี และการปฏิบัติตามเงื่อนไข สมาชิกควรตรวจสอบข้อมูลและข้อกำหนดล่าสุดก่อนส่งคำขอถอน",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement3
    message="📢 EZWIN168 เว็บมั่นคงสล็อตออนไลน์ โปรทุนน้อยคืนยอดเสีย จ่ายทุกบิล ฝากถอนออโต้ รองรับมือถือทุกระบบ ควรอ่านเงื่อนไขโปรโมชั่นและข้อกำหนดการถอนก่อนรับสิทธิ์ทุกครั้ง"
  />

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h1" title="EZWIN168 | เว็บมั่นคงสล็อตออนไลน์ โปรทุนน้อยคืนยอดเสีย จ่ายทุกบิล">
    <p class="text-left text-base leading-relaxed text-emerald-50/85">
      EZWIN168 เป็นแพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมหลายรูปแบบ พร้อมระบบฝากถอนออโต้และโปรโมชั่นสำหรับผู้เล่นที่ต้องการเริ่มต้นด้วยงบประมาณจำกัด
      จุดเด่นอยู่ที่สิทธิ์คืนยอดเสียและการตรวจสอบรายการตามเงื่อนไขที่กำหนด สมาชิกควรอ่านรายละเอียดโปรโมชั่น กติกาเกม และข้อกำหนดการถอนก่อนใช้งานทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxSevenThreeFloatingBadge title="EZWIN168 รวมสล็อตออนไลน์หลายแนวในระบบเดียว">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgGameVariety}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="EZWIN168 เว็บตรง เล่นกับบริษัทแม่โดยตรง ลิขสิทธิ์แท้ รวมค่ายเกมสล็อตชื่อดังไว้ในระบบเดียว"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/40 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-emerald-50/85">
      ภายในระบบมีเกมสล็อตทั้งแบบคลาสสิก วิดีโอสล็อต เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ผู้เล่นสามารถค้นหาเกมตามค่าย ธีม หรือระดับความผันผวนได้ง่าย
      ควรอ่านกติกาและตรวจสอบข้อมูลของแต่ละเกมก่อนเริ่ม เพื่อเลือกเกมให้เหมาะกับงบประมาณและรูปแบบการเล่นของตนเอง
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThree titleright="โปรทุนน้อยช่วยให้เริ่มต้นตามงบประมาณได้ง่ายขึ้น">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgLowBudgetPromo}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="EZWIN168 โปรทุนน้อยและเครดิตฟรีตามเงื่อนไข เริ่มต้นได้ตามงบประมาณที่วางไว้"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/40 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-emerald-50/85">
      โปรโมชั่นทุนน้อยเหมาะกับผู้ที่ต้องการเริ่มจากยอดที่ไม่สูง แต่แต่ละรายการอาจกำหนดยอดฝาก เกมที่เข้าร่วม และเงื่อนไขการถอนแตกต่างกัน
      ผู้เล่นจึงควรเปรียบเทียบรายละเอียดก่อนรับสิทธิ์ และไม่ควรเพิ่มเงินเกินแผนเพียงเพื่อให้ผ่านข้อกำหนดของโปรโมชั่น
    </p>
  </ContentBoxSevenThree>

  <ContentBoxCyberCut as="h2" title="คืนยอดเสียตามรอบและเงื่อนไขที่กำหนดที่ EZWIN168">
    <p class="text-left text-base leading-relaxed text-emerald-50/85">
      สิทธิ์คืนยอดเสียอาจคำนวณจากยอดขาดทุนสุทธิในช่วงเวลาที่เว็บไซต์ระบุ โดยมีอัตราคืน ยอดสูงสุด และเกมที่ร่วมรายการต่างกัน
      สมาชิกควรตรวจสอบว่าระบบคืนให้อัตโนมัติหรือต้องกดรับเอง รวมถึงอ่านข้อกำหนดการนำเครดิตไปใช้และการถอนให้ครบถ้วน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSpecial as="h2" title="ฝากถอนออโต้ EZWIN168 ช่วยลดขั้นตอนการทำรายการ">
    <p slot="left">
      ระบบออโต้ช่วยให้สมาชิกทำรายการฝากและถอนผ่านหน้าเว็บไซต์ได้ด้วยตนเอง ควรใช้บัญชีธนาคารที่ตรงกับข้อมูลสมัคร ตรวจสอบยอดก่อนยืนยัน
      และเก็บหลักฐานรายการไว้จนกว่าจะเสร็จสมบูรณ์
    </p>
    <p slot="right">หากพบความล่าช้าควรติดต่อทีมงานผ่านช่องทางหลัก พร้อมแจ้งข้อมูลที่จำเป็นให้ครบ</p>
  </ContentBoxSpecial>

  <LatestWinners3 />

  <ContentBoxNeumorphism as="h2" title="การจ่ายทุกบิลควรตรวจสอบสถานะและข้อกำหนดร่วมด้วย">
    <p class="text-left text-base leading-relaxed text-emerald-50/85">
      คำว่าจ่ายทุกบิลควรพิจารณาควบคู่กับสถานะบัญชี ยอดคงเหลือ เงื่อนไขโปรโมชั่น และขั้นตอนตรวจสอบของระบบ
      สมาชิกควรกรอกข้อมูลให้ถูกต้องและทำรายการผ่านบัญชีของตนเองเท่านั้น การตรวจสอบรายละเอียดก่อนถอนจะช่วยลดปัญหารายการถูกพักหรือต้องส่งข้อมูลเพิ่มเติม
    </p>
  </ContentBoxNeumorphism>

  <ContentBox as="h2" title="EZWIN168 มีช่องทางดูแลปัญหาตลอดการใช้งาน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-emerald-50/85">
        หากพบปัญหาเกี่ยวกับการเข้าสู่ระบบ โปรโมชั่นคืนยอดเสีย หรือสถานะฝากถอน สามารถติดต่อทีมงานผ่านช่องทางที่เว็บไซต์กำหนด ควรเตรียมชื่อผู้ใช้ เวลา
        และรายละเอียดรายการให้ครบ โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้อื่น เพื่อช่วยให้ทีมงานตรวจสอบได้รวดเร็วขึ้น
      </p>
      <FeatureHighlights items={supportPoints} />
    </div>
  </ContentBox>

  <LoginRtpSection />

  <Faq3 faqs={faqs} />

  <Navfoot />
</MainLayout>
