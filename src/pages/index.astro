---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import imgProviders from "../assets/slide2.png";
import imgFlexibleFinance from "../assets/slide1.png";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "PORING168 สล็อตเว็บตรง มาตรฐานสากล รองรับทรูวอเลท ไม่มีขั้นต่ำ";
const pageDescription =
  "PORING168 สล็อตเว็บตรง มาตรฐานสากล สัมผัสความยืดหยุ่นทางการเงินขั้นสุด ฝากถอน ไม่มีขั้นต่ำ สะดวกรวดเร็ว รองรับทรูวอเลท ลื่นไหล ปลอดภัย 100%";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "PORING168",
  description: pageDescription,
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "PORING168",
  alternateName: ["PORING168", "PORING168 สล็อตเว็บตรง มาตรฐานสากล รองรับทรูวอเลท ไม่มีขั้นต่ำ"],
  url: "https://poring168-plays.com",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "PORING168",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

const providerPoints = [
  {
    icon: "🎮",
    title: "PG Soft กราฟิกสมจริง ฟีเจอร์ล้ำสมัย แตกง่ายทุกจังหวะ",
    description: "ค่ายผู้พัฒนาที่โดดเด่นในเรื่องภาพแอนิเมชัน 3D และกลไกเกมที่ไหลลื่น เข้ากับความคล่องตัวของเว็บได้อย่างลงตัว โบนัสออกบ่อย สร้างความคุ้มค่าได้อย่างต่อเนื่อง",
    accent: "gold" as const,
  },
  {
    icon: "💥",
    title: "Pragmatic Play ความสนุกไร้ขีดจำกัด โบนัสเด้งรัวๆ",
    description: "นำเสนอความบันเทิงที่เข้าใจง่ายแต่แฝงด้วยกลไกการแจกรางวัลที่ทรงพลัง สปินแต่ละรอบเต็มไปด้วยโอกาสในการรับผลตอบแทนที่รวดเร็วทันใจ",
    accent: "blue" as const,
  },
  {
    icon: "⚡",
    title: "JILI เอฟเฟกต์จัดจ้าน รางวัลแตกไว รองรับทุกอุปกรณ์",
    description: "ผสานความเรียบง่ายเข้ากับนวัตกรรมเกมเพลย์ที่น่าดึงดูด ระบบเซิร์ฟเวอร์เสถียรสุดยอด ทำให้กอบโกยกำไรได้อย่างเต็มที่ไม่มีกระตุก",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "การ ฝากถอน ผ่านระบบอัตโนมัติใช้เวลานานหรือไม่?",
    a: "ประมวลผลด้วยความไวสูง ยอดเงินอัปเดตเข้ากระเป๋าในไม่กี่วินาที สะดวกรวดเร็ว และแม่นยำที่สุด",
  },
  {
    q: "ทำไม สล็อตเว็บตรง ถึงต้องมีนโยบายทางการเงินที่เปิดกว้าง?",
    a: "เพื่อให้ผู้ใช้งานได้ สัมผัสความยืดหยุ่นทางการเงินขั้นสุด สามารถบริหารทุนของตนเองได้อย่างอิสระโดย ไม่มีขั้นต่ำ",
  },
  {
    q: "แอปพลิเคชันที่ใช้ รองรับทรูวอเลท มีค่าธรรมเนียมเพิ่มเติมไหม?",
    a: "ไม่มีค่าธรรมเนียมแอบแฝงใดๆ ทั้งสิ้น แพลตฟอร์ม PORING168 ให้คุณทำธุรกรรมได้ฟรีและ ลื่นไหล ตลอดเวลา",
  },
  {
    q: "ข้อมูลส่วนตัวและยอดเครดิตจะได้รับการปกป้องอย่างไร?",
    a: "เราใช้เทคโนโลยีความปลอดภัยระดับ มาตรฐานสากล ทำให้มั่นใจได้ว่าทุกข้อมูลของคุณจะ ปลอดภัย 100%",
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement
    message="📢 PORING168 สล็อตเว็บตรง มาตรฐานสากล ฝากถอนไม่มีขั้นต่ำ รองรับทรูวอเลท ประมวลผลอัตโนมัติในเสี้ยววินาที ลื่นไหล ปลอดภัย 100% ทุกการเชื่อมต่อ"
  />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="PORING168 สล็อตเว็บตรง มาตรฐานสากล รองรับทรูวอเลท ไม่มีขั้นต่ำ">
    <p class="text-left text-base leading-relaxed text-blue-50/85">
      เปิดประสบการณ์ความบันเทิงรูปแบบใหม่กับ PORING168 สล็อตเว็บตรง ที่ถูกออกแบบมาด้วยเทคโนโลยีสถาปัตยกรรมแบบเปิด (Open Architecture)
      มอบความรู้สึกที่ลื่นไหลและปรับตัวได้กับทุกสไตล์การใช้งาน เรานำเสนอมาตรฐานสากลให้คุณได้สัมผัสความยืดหยุ่นทางการเงินขั้นสุด ผ่านระบบฝากถอนแบบไม่มีขั้นต่ำ
      ที่ประมวลผลได้อย่างสะดวกรวดเร็ว พร้อมรองรับทรูวอเลท เพื่อการใช้งานที่ราบรื่นและปลอดภัย 100% ตอบโจทย์คนยุคดิจิทัลอย่างสมบูรณ์แบบ
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium titleright="PORING168 รวมค่ายเกมชั้นนำ ลื่นไหล ปลอดภัย 100%">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgProviders}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="PORING168 รวมค่ายเกมสล็อตชั้นนำไว้ในระบบเดียว พร้อมโปรโมชั่นฝากครั้งแรกลุ้นรับทองคำ 1 บาท"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/40 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-blue-50/85">
        แพลตฟอร์มของเราถูกสร้างขึ้นด้วยโครงสร้างระบบที่เน้นความเสถียรและไร้รอยต่อ เพื่อรวบรวมซอฟต์แวร์ระดับโกลบอลมาไว้ในที่เดียว ทุกการเชื่อมต่อจะถูกประมวลผลอย่างนุ่มนวล
        มอบกราฟิกที่สวยงามและอัตราการออกโบนัสที่ยุติธรรม ให้คุณกอบโกยผลตอบแทนได้อย่างเต็มที่โดยไม่ต้องกังวลเรื่องระบบขัดข้อง
      </p>
      <FeatureHighlights items={providerPoints} />
    </div>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism titleright="สัมผัสความยืดหยุ่นทางการเงินขั้นสุด ไม่มีขั้นต่ำ ทุกยอด">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgFlexibleFinance}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="PORING168 โปรโมชั่นคืนยอดเสียสูงสุด 15% รองรับการฝากถอนแบบไม่มีขั้นต่ำทุกยอด"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/40 shadow-[0_10px_30px_rgba(251,191,36,0.3)]"
      />
    </div>
    <p slot="right" class="text-left text-base leading-relaxed text-blue-50/85">
      ทลายกำแพงแห่งการลงทุนด้วยนโยบายที่เปิดกว้างและให้อิสระอย่างเต็มที่ ไม่ว่าคุณจะเริ่มต้นด้วยทุนเท่าไหร่ก็สามารถกำหนดเป้าหมายได้ตามต้องการ
      นวัตกรรมทางการเงินนี้ถูกออกแบบมาเพื่อรองรับไลฟ์สไตล์ที่หลากหลาย ทำให้ทุกคนมีสิทธิ์เข้าถึงโอกาสในการสร้างรายได้อย่างเท่าเทียม
      เป็นการเปิดมิติใหม่ของการจัดการเครดิตที่ไร้กรอบจำกัดอย่างแท้จริง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxNeumorphism as="h2" title="แพลตฟอร์ม PORING168 สะดวกรวดเร็ว รองรับทรูวอเลท">
    <p class="text-left text-base leading-relaxed text-blue-50/85">
      อัปเกรดความสะดวกสบายไปอีกขั้นด้วยการเชื่อมต่อระบบการเงินเข้ากับกระเป๋าเงินอิเล็กทรอนิกส์ชั้นนำ การโอนถ่ายข้อมูลบน PORING168 ถูกประมวลผลด้วยเทคโนโลยีอัตโนมัติ
      ทำให้ยอดเครดิตเด้งเข้าสู่แดชบอร์ดในเวลาเพียงเสี้ยววินาที ลดขั้นตอนที่ยุ่งยากและมอบความไวแบบที่คุณไม่เคยสัมผัสมาก่อน ตอบโจทย์การทำธุรกรรมแบบเรียลไทม์ได้อย่างสมบูรณ์แบบ
    </p>
  </ContentBoxNeumorphism>

  <LatestWinners2 />

  <ContentBoxCyberCut as="h2" title="มาตรฐานสากลจาก PORING168 ลื่นไหล ปลอดภัย ทุกการเชื่อมต่อ">
    <p class="text-left text-base leading-relaxed text-blue-50/85">
      ความน่าเชื่อถือคือสิ่งที่เราให้ความสำคัญเป็นอันดับหนึ่ง ฐานข้อมูลทั้งหมดได้รับการปกป้องด้วยระบบเข้ารหัสขั้นสูงแบบหลายชั้น (Multi-layer Encryption)
      เพื่อป้องกันความเสี่ยงจากภายนอก หน้าต่างการโหลดข้อมูลถูกนำเสนอในรูปแบบ Secure Popup Modal มั่นใจได้ว่าทุกคลิกของคุณจะได้รับการปกป้องระดับสูงสุด ไร้ความกังวล
    </p>
  </ContentBoxCyberCut>

  <LoginRtpSection />

  <Faq faqs={faqs} title="คำถามที่พบบ่อย (FAQ) เกี่ยวกับการใช้งาน PORING168" />

  <Navfoot />
</MainLayout>
