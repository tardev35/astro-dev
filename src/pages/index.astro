---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement5 from "../components/Announcement5.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import imgProviders from "../assets/slide1.png";
import imgAutoWallet from "../assets/slide2.png";
import imgFreeCredit from "../assets/banner2.png";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const pageTitle = "NOVA852 | เว็บพนันออนไลน์ค่ายดัง ฝากถอนระบบออโต้ ปลอดภัย มั่นคง";
const pageDescription = "ปั้นพอร์ตทำกำไรกับ NOVA852 เว็บพนันออนไลน์ค่ายดัง ฝากถอนระบบออโต้ผ่าน AI อัจฉริยะ API แท้ไม่ล็อคยูสเซอร์ ปลอดภัย มั่นคง จ่ายจริงถอนได้เต็ม 100%";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "NOVA852",
  description: pageDescription,
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "NOVA852",
  alternateName: ["NOVA852", "NOVA852 เว็บพนันออนไลน์ค่ายดัง ฝากถอนระบบออโต้ ปลอดภัย มั่นคง"],
  url: "https://www.nova852.online/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "NOVA852",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

const gameCategories = [
  {
    icon: "🎰",
    title: "สล็อตออนไลน์",
    description: "รวมเกมสล็อตจากค่ายชั้นนำระดับโลกไว้ในที่เดียว เชื่อมต่อผ่าน API แท้ เลือกเล่นได้ตามสไตล์ที่ชอบ เริ่มต้นด้วยทุนก้อนเล็กก็ปั้นพอร์ตได้",
    accent: "gold" as const,
  },
  {
    icon: "🎴",
    title: "คาสิโนสด",
    description: "ถ่ายทอดสดจากสตูดิโอจริงแบบเรียลไทม์ ทั้งบาคาร่า รูเล็ต และเกมยอดนิยม ภาพคมชัดไม่มีสะดุด เล่นได้เหมือนนั่งอยู่ในบ่อนระดับสากล",
    accent: "blue" as const,
  },
  {
    icon: "🎲",
    title: "เกมโต๊ะ",
    description: "เกมโต๊ะครบทุกรูปแบบ กติกาเข้าใจง่าย เหมาะกับนักลงทุนทุกระดับตั้งแต่มือใหม่ที่เพิ่งเปิดยูสจนถึงเซียนขาประจำ",
    accent: "gold" as const,
  },
  {
    icon: "⚽",
    title: "กีฬาออนไลน์",
    description: "เดิมพันกีฬาหลากหลายลีกทั่วโลก ดูราคาต่อรองและติดตามผลการแข่งขันแบบสดได้ครบภายในบัญชีเดียว",
    accent: "blue" as const,
  },
  {
    icon: "👤",
    title: "ระบบสมาชิกอัตโนมัติ",
    description: "จัดการข้อมูล ฝากถอน และตรวจสอบประวัติทุกธุรกรรมผ่านบัญชีเดียวที่เชื่อมต่อทุกบริการเข้าด้วยกันด้วยระบบ AI อัจฉริยะ",
    accent: "gold" as const,
  },
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement5 />

  <ContentBoxNeumorphism as="h1" title="NOVA852 เว็บพนันออนไลน์ค่ายดัง ฝากถอนระบบออโต้ ปลอดภัย มั่นคง">
    <p class="mx-auto max-w-4xl leading-relaxed">
      ยินดีต้อนรับสู่อาณาจักรการลงทุนออนไลน์ที่ล้ำสมัยที่สุดกับ <strong class="text-amber-300">NOVA852</strong> เว็บพนันออนไลน์ค่ายดัง ฝากถอนระบบออโต้ ปลอดภัย มั่นคง แพลตฟอร์มที่เชื่อมต่อระบบ API แท้
      มอบประสบการณ์เสี่ยงโชคที่โปร่งใส ไม่มีการล็อคยูสเซอร์ เปิดโอกาสให้คุณเข้ามาโกยเงินรางวัลก้อนโตกลับบ้านได้อย่างมั่นใจและรวดเร็วที่สุดผ่านนวัตกรรมที่ล้ำหน้า
    </p>
  </ContentBoxNeumorphism>

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h2" title="NOVA852 เว็บพนันออนไลน์ค่ายดัง รวมตัวเลือกเกมยอดนิยม">
    <p class="mx-auto max-w-4xl leading-relaxed">
      เปิดประสบการณ์ทำกำไรไร้ขีดจำกัดไปกับ <strong class="text-amber-300">NOVA852</strong> เว็บพนันออนไลน์ค่ายดัง รวมตัวเลือกเกมยอดนิยม เราคัดสรรเฉพาะแบรนด์ชั้นนำระดับโลกที่ได้มาตรฐานสากลมาไว้ในที่เดียว
      ตอบโจทย์นักลงทุนยุคดิจิทัลที่ต้องการความหลากหลาย ช่วยให้คุณขยายพอร์ตความมั่งคั่งและสนุกกับการสร้างรายได้แบบไม่มีเบื่อ พร้อมกวาดกำไรเข้าบัญชีได้อย่างง่ายดาย
    </p>
  </ContentBoxNeumorphism>

  <div class="mx-auto mb-10 w-full max-w-[1400px] px-4">
    <FeatureHighlights items={gameCategories} />
  </div>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism titleright="แนะนำจุดเด่นของเกมจากค่ายชั้นนำที่เล่นง่าย">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgProviders}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="NOVA852 รวมเกมค่ายดังระบบ API แท้ ไม่ล็อคยูสเซอร์ สปินโปร่งใสทุกตา"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/25 shadow-[0_10px_30px_rgba(251,191,36,0.25)]"
      />
    </div>
    <p slot="right" class="leading-relaxed">
      สัมผัสความเหนือระดับของการเสี่ยงโชคพร้อม แนะนำจุดเด่นของเกมจากค่ายชั้นนำที่เล่นง่าย ระบบของเราทำงานผ่านนวัตกรรมสุดล้ำ ไม่มีการแทรกแซงกลไกหลังบ้าน มั่นใจได้ว่าทุกการสปินจะโปร่งใส ยุติธรรม
      และให้อัตราการจ่ายผลตอบแทนที่สูงปรี๊ดตามสถิติความน่าจะเป็นระดับสากลอย่างแท้จริง ไร้กังวลเรื่องโดนโกงหรือดึงเรทแพ้ชนะแน่นอน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <GameRankingBoard />

  <ContentBoxSevenThree titleright="NOVA852 ฝากถอนระบบออโต้ ทำรายการสะดวกและรวดเร็ว">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgAutoWallet}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="NOVA852 ฝากถอนระบบออโต้ด้วย AI อัจฉริยะ โอนเข้าบัญชีทันทีในเสี้ยววินาที"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-amber-400/25 shadow-[0_10px_30px_rgba(251,191,36,0.25)]"
      />
    </div>
    <p slot="right" class="leading-relaxed">
      บริหารกระแสเงินสดของคุณอย่างลื่นไหลเพราะ <strong class="text-amber-300">NOVA852</strong> ฝากถอนระบบออโต้ ทำรายการสะดวกและรวดเร็ว นวัตกรรมเอไออัจฉริยะจะทำหน้าที่ประมวลผลธุรกรรมทางการเงินในเสี้ยววินาที
      เมื่อคุณทำกำไรทะลุเป้าหมายหลักล้าน ระบบก็พร้อมโอนยอดเงินสดเข้าบัญชีทันที ขจัดปัญหาความล่าช้าและไม่ต้องรอนาน มอบสภาพคล่องที่ตอบโจทย์วัยรุ่นยุคใหม่
    </p>
  </ContentBoxSevenThree>

  <LoginRtpSection />

  <ContentBoxFloatingBadge as="h2" title="เหตุผลที่เว็บพนันออนไลน์มั่นคงได้รับความไว้วางใจอย่างต่อเนื่อง">
    <p class="mx-auto max-w-4xl leading-relaxed">
      ค้นพบคำตอบสุดเอ็กซ์คลูซีฟและ เหตุผลที่เว็บพนันออนไลน์มั่นคงได้รับความไว้วางใจอย่างต่อเนื่อง โครงสร้างเว็บไซต์ของเรามีความเสถียรขั้นสูงสุด ฐานข้อมูลถูกคุ้มครองด้วยเทคโนโลยีเข้ารหัสขั้นสูง
      ป้องกันการแฮ็กได้อย่างไร้รอยรั่ว ผสานกับระบบที่ไม่ล็อคผลรางวัล จึงทำให้เซียนพนันยุคใหม่มั่นใจในการเลือกลงทุนด้วยเงินก้อนโต
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title="สรุปความน่าสนใจของ NOVA852 ทั้งเกมค่ายดัง ระบบอัตโนมัติ">
    <p class="mx-auto max-w-4xl leading-relaxed">
      ก้าวเข้าสู่อาณาจักรทำเงินที่ตอบโจทย์คนยุคดิจิทัลเพื่อ สรุปความน่าสนใจของ <strong class="text-amber-300">NOVA852</strong> ทั้งเกมค่ายดัง ระบบอัตโนมัติ สมัครเปิดยูสเซอร์ใหม่กับเราวันนี้ผ่านแพลตฟอร์มที่รวดเร็วและเป็นความลับ
      ทันทีที่ยืนยันตัวตนสำเร็จ คุณก็พร้อมนำเครดิตฟรีเข้ามาสอยแจ็กพอตใหญ่และพลิกชีวิตสู่เศรษฐีหน้าใหม่ได้อย่างยั่งยืน การันตีจ่ายจริงร้อยเปอร์เซ็นต์
    </p>
    <Picture
      src={imgFreeCredit}
      loading="lazy"
      fetchpriority="low"
      widths={[400, 672, 900]}
      sizes="(max-width: 768px) 100vw, 672px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="NOVA852 สมาชิกใหม่รับเครดิตฟรี 100 เปิดยูสเซอร์ผ่านระบบออโต้"
      class="mx-auto mt-8 h-auto w-full max-w-2xl rounded-2xl border border-amber-400/25 shadow-[0_10px_30px_rgba(251,191,36,0.2)]"
    />
  </ContentBoxNeumorphism>

  <div class="mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-slate-300/50 bg-[#0b1120]/80 px-4 py-3 text-sm font-black whitespace-nowrap text-slate-100 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-slate-700/40 hover:shadow-[0_0_15px_rgba(203,213,225,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-yellow-300 via-amber-400 to-amber-500 px-4 py-3 text-sm font-black whitespace-nowrap text-[#0b1120] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBoxSpecial as="h2" title="ระบบความปลอดภัยที่ช่วยดูแลข้อมูลสมาชิกอย่างเป็นมาตรฐาน">
    <p slot="left" class="leading-relaxed">
      ทลายทุกข้อจำกัดของการลงทุนด้วย ระบบความปลอดภัยที่ช่วยดูแลข้อมูลสมาชิกอย่างเป็นมาตรฐาน แพลตฟอร์มของเราเลือกใช้เทคโนโลยีไฟร์วอลล์ระดับสถาบันการเงิน
      เพื่อปกป้องข้อมูลส่วนบุคคลและกระเป๋าเงินดิจิทัลของคุณจากการโจรกรรมทางไซเบอร์
    </p>
    <p slot="right" class="leading-relaxed">มอบความสบายใจขั้นสุดให้คุณสามารถมุ่งสมาธิไปกับการวางแผนกลยุทธ์ทำกำไรได้อย่างเต็มประสิทธิภาพ</p>
  </ContentBoxSpecial>

  <Faq3 />

  <LatestWinners4 />

  <Navfoot />
</MainLayout>
