---
const targetUrl = "https://yoalink.com/mucr";
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <title>เข้าสู่ระบบ LONDON999VIP | รวมค่ายเกมสล็อตยอดฮิต ฝากถอนไว</title>
    <meta name="description" content="ล็อกอินเข้าสู่นวัตกรรมทำเงิน LONDON999VIP รวมค่ายเกมสล็อตยอดฮิต มั่นคงปลอดภัย ฝากถอนไวด้วยระบบ AI อัจฉริยะ API แท้ไม่ล็อคยูสเซอร์ จ่ายเต็ม 100%" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&family=Oswald:wght@700&display=swap" rel="stylesheet" />

    <style>
      :root {
        --dark-bg: #040b1e;
        --brand-blue: #3b82f6;
        --brand-blue-deep: #1d4ed8;
        --brand-red: #dc2626;
        --brand-gold: #facc15;
        --text-white: #f9fafb;
        --text-grey: #cbd5e1;
      }

      body {
        margin: 0;
        font-family: "Kanit", sans-serif;
        color: var(--text-white);

        background: radial-gradient(circle at 50% 10%, rgba(37, 99, 235, 0.45) 0%, transparent 50%), var(--dark-bg);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: rgba(7, 20, 51, 0.55);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 2rem;
        box-shadow: 0 1rem 4rem rgba(0, 0, 0, 0.5);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-white);
        letter-spacing: 0.3em;
        margin-bottom: 2rem;
        text-shadow: 0 0 1rem rgba(37, 99, 235, 0.9);
      }

      .brand-identity .vip {
        color: var(--brand-gold);
        text-shadow: 0 0 1rem rgba(250, 204, 21, 0.6);
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, #60a5fa 0%, var(--brand-blue-deep) 85%);
        border-radius: 50%;
        box-shadow: 0 0 3rem rgba(37, 99, 235, 1);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(37, 99, 235, 0.15);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: rgba(255, 255, 255, 0.7);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: rgba(220, 38, 38, 0.85);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 3rem rgba(37, 99, 235, 1);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 4.5rem rgba(59, 130, 246, 1);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-white);
        text-shadow: 0 0 1rem rgba(255, 255, 255, 0.3);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-grey);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">LONDON999<span class="vip">VIP</span></div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ LONDON999VIP 🔒</p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
