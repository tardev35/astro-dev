---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";

const promotions = [
  { src: pro1, alt: "โปรโมชั่น PGZEED168 โปรพิเศษขาประจำ ฝากครบ 3 วัน รับโบนัสเพิ่ม 500 บาท" },
  { src: pro2, alt: "โปรโมชั่น PGZEED168 คืนยอดเสียสล็อต 20% คาสิโน 5% ยิงปลา 3%" },
  { src: pro3, alt: "โปรโมชั่น PGZEED168 ฝากรับเพิ่ม 5% ทำเทิร์นเพียง 1 เท่า ถอนได้ทันที" },
  { src: pro4, alt: "โปรโมชั่น PGZEED168 ฝากวันนี้ 500 บาท รับฟรีเพิ่มอีก 4 ฟังก์ชัน" },
];
---

<MainLayout
  title="โปรโมชั่น EZWIN168 | โปรทุนน้อยและคืนยอดเสียตามเงื่อนไข" description="รวมโปรโมชั่น EZWIN168 สำหรับผู้เล่นทุนน้อย พร้อมสิทธิ์คืนยอดเสีย โบนัสสมาชิก และกิจกรรมพิเศษตามเงื่อนไขที่เว็บไซต์กำหนด">
  <Announcement />

  <ContentBox title="โปรโมชั่น PGZEED168 โบนัสสล็อตยอดนิยม อัปเกรดทุนด้วย AI อัจฉริยะ">
    <p class="mb-10 text-left text-base leading-relaxed">
      อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก PGZEED168 สล็อตเกมยอดนิยม โบนัสเข้าง่าย ฝากถอนออโต้ มั่นคง กดรับโบนัสเครดิตฟรีเพื่ออัปเกรดเงินทุนตั้งต้นและเพิ่มโอกาสสอยแจ็กพอตใหญ่ได้ต่อเนื่อง
      ทุกแคมเปญคำนวณและเติมเครดิตอัตโนมัติด้วยระบบเอไออัจฉริยะ ไม่ต้องส่งสลิปและไม่ต้องรอคิวแอดมิน เมื่อทำกำไรถึงเป้าก็ถอนได้ทันที การันตีจ่ายเต็ม 100% ผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promotions.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="mx-auto h-auto w-full rounded-xl border border-lime-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-lime-300 hover:shadow-[0_10px_20px_rgba(163,230,53,0.5)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-lime-500 via-lime-300 to-lime-500 px-10 py-3.5 text-lg font-black text-[#0a1a0e] shadow-[0_0_20px_rgba(163,230,53,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
