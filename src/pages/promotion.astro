---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";

const promotions = [
  { src: pro1, alt: "โปรโมชั่น EZWIN168 บัญชีปลอดภัย 100% หมดปัญหาเรื่องบัญชีโดนอายัด" },
  { src: pro2, alt: "โปรโมชั่น EZWIN168 เว็บตรง เล่นกับบริษัทแม่โดยตรง ลิขสิทธิ์แท้ 100% รวมค่ายดังระดับโลก" },
  { src: pro3, alt: "โปรโมชั่น EZWIN168 เครดิตฟรี แจกฟรีทุกวัน ถอนได้จริง ทั้งสมาชิกเก่าและใหม่" },
  { src: pro4, alt: "โปรโมชั่น EZWIN168 ระบบออกแบบด้วยมาตรฐานความปลอดภัยระดับสากล" },
];
---

<MainLayout
  title="โปรโมชั่น EZWIN168 | โปรทุนน้อยและคืนยอดเสียตามเงื่อนไข"
  description="รวมโปรโมชั่น EZWIN168 สำหรับผู้เล่นทุนน้อย พร้อมสิทธิ์คืนยอดเสีย โบนัสสมาชิก และกิจกรรมพิเศษตามเงื่อนไขที่เว็บไซต์กำหนด">
  <Announcement />

  <ContentBox title="โปรโมชั่น EZWIN168 โปรทุนน้อยและคืนยอดเสียตามเงื่อนไข">
    <p class="mb-10 text-left text-base leading-relaxed">
      EZWIN168 รวมโปรโมชั่นสำหรับผู้เล่นที่ต้องการเริ่มต้นด้วยงบประมาณจำกัด ทั้งโปรทุนน้อย โบนัสสมาชิก สิทธิ์คืนยอดเสีย และกิจกรรมพิเศษตามรอบที่เว็บไซต์กำหนด แต่ละรายการอาจกำหนดยอดฝากขั้นต่ำ เกมที่เข้าร่วม
      และเงื่อนไขการถอนแตกต่างกัน ผู้เล่นจึงควรเปรียบเทียบรายละเอียดก่อนรับสิทธิ์ และไม่ควรเพิ่มเงินเกินแผนเพียงเพื่อให้ผ่านข้อกำหนดของโปรโมชั่น สำหรับสิทธิ์คืนยอดเสียมักคำนวณจากยอดขาดทุนสุทธิในช่วงเวลาที่ระบุ
      โดยอัตราคืน ยอดสูงสุด และเกมที่ร่วมรายการต่างกัน สมาชิกควรตรวจสอบว่าระบบคืนให้อัตโนมัติหรือต้องกดรับเอง รวมถึงอ่านข้อกำหนดการนำเครดิตไปใช้และการถอนให้ครบถ้วนก่อนทุกครั้ง
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promotions.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="mx-auto h-auto w-full rounded-xl border border-amber-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(251,191,36,0.5)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 px-10 py-3.5 text-lg font-black text-[#04170d] shadow-[0_0_20px_rgba(251,191,36,0.6)] transition-transform hover:scale-105">
        ดูเงื่อนไขและสมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
