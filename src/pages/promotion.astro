---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout title="โปรโมชั่น LONDON999VIP | โบนัสวีไอพี อัปเกรดทุนด้วย AI อัจฉริยะ" description="อัปเดตแพ็กเกจโปรโมชั่นระดับวีไอพีจาก LONDON999VIP รวมค่ายเกมสล็อตยอดฮิต กดรับเครดิตฟรีเพื่อเพิ่มโอกาสสอยแจ็กพอตแตกง่าย ทำกำไรผ่านระบบ API แท้">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-white via-blue-200 to-blue-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น LONDON999VIP</h1>

    <p class="mx-auto mb-8 max-w-3xl text-blue-100/90">
      รวมแพ็กเกจโปรโมชั่นระดับวีไอพีของ LONDON999VIP ทั้งโบนัสสมาชิกใหม่ โบนัสฝากแรกของวัน นาทีทองรับเพิ่ม และคืนยอดเสียสำหรับผู้เล่นประจำ กดรับเครดิตผ่านระบบออโต้ได้ทันที ไม่ต้องแจ้งแอดมิน
    </p>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น LONDON999VIP นาทีทอง 07:00 - 09:00 น. รับเพิ่ม 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#2563eb]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#3b82f6] hover:shadow-[0_10px_20px_rgba(37,99,235,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น LONDON999VIP สมัครสมาชิกและฝากเงินครั้งแรกภายในวันที่สมัคร รับโบนัสเพิ่ม 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#2563eb]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#3b82f6] hover:shadow-[0_10px_20px_rgba(37,99,235,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น LONDON999VIP สมาชิกใหม่ ฝากทันที รับเพิ่ม 50%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#2563eb]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#3b82f6] hover:shadow-[0_10px_20px_rgba(37,99,235,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="โปรโมชั่น LONDON999VIP ยิ่งฝากเยอะยิ่งได้เยอะ คืนยอดเสียสูงสุด 10,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#2563eb]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#3b82f6] hover:shadow-[0_10px_20px_rgba(37,99,235,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-blue-300/60 bg-gradient-to-r from-blue-600 to-blue-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(37,99,235,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
