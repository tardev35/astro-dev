---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";

const promotions = [
  { src: pro1, alt: "โปรโมชั่น KINGHENG168 สมาชิกใหม่ ฝากทันทีรับเพิ่ม 50%" },
  { src: pro2, alt: "โปรโมชั่น KINGHENG168 ยิ่งฝากเยอะ ยิ่งได้เยอะ คืนยอดเสียสูงสุด 10,000 บาท" },
  { src: pro3, alt: "โปรโมชั่น KINGHENG168 นาทีทอง 07:00-09:00 น. รับเพิ่ม 20%" },
  { src: pro4, alt: "โปรโมชั่น KINGHENG168 สมัครและฝากครั้งแรกในวันที่สมัคร รับโบนัสเพิ่ม 20%" },
];
---

<MainLayout
  title="โปรโมชั่น KINGHENG168 | โบนัสสล็อตทำเงิน อัปเกรดทุนด้วย AI อัจฉริยะ"
  description="อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก KINGHENG168 สล็อตทำเงินง่ายรายได้ดี กดรับโบนัสเครดิตฟรีเพื่อเพิ่มโอกาสสอยแจ็กพอตแตกง่าย ทำกำไรอย่างมั่นใจผ่านระบบ API แท้">
  <Announcement />

  <ContentBox title="โปรโมชั่น KINGHENG168 โบนัสสล็อตทำเงิน อัปเกรดทุนด้วย AI อัจฉริยะ">
    <p class="mb-10 text-base leading-relaxed">
      อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก KINGHENG168 สล็อตทำเงินง่ายรายได้ดี แตกง่ายจ่ายจริง กดรับโบนัสเครดิตฟรีเพื่ออัปเกรดเงินทุนตั้งต้นและเพิ่มโอกาสสอยแจ็กพอตใหญ่ได้ต่อเนื่อง
      ทุกแคมเปญคำนวณและเติมเครดิตอัตโนมัติด้วยระบบเอไออัจฉริยะ ไม่ต้องส่งสลิปและไม่ต้องรอคิวแอดมิน เมื่อทำกำไรถึงเป้าก็ถอนได้ทันที การันตีจ่ายเต็ม 100% ผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promotions.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="mx-auto h-auto w-full rounded-xl border border-amber-500/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_20px_rgba(245,158,11,0.5)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 px-10 py-3.5 text-lg font-black text-[#1a1206] shadow-[0_0_20px_rgba(245,158,11,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
