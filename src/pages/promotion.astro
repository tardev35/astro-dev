---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout title="โปรโมชั่น PABLO666 อัปเดตล่าสุด โบนัส สล็อต1บาท ก็ฝากได้" description="อัปเดตโปรโมชั่น PABLO666 ล่าสุด รับโบนัส ฝากถอนออโต้ สล็อต1บาท ก็ฝากได้ ระบบออโต้หลังบ้านอัจริยะ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น PABLO666</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่นวันเกิด รับทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่นยอดฮิต ฝาก 50 รับ 100"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="แทงบาคาร่า 6 ไม้ ชนะติดกัน รับเงินทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ฝากแรกของวัน รับโบนัสฟรี 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-amber-700 to-amber-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(234,179,8,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #fbbf24 0%, #eab308 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
