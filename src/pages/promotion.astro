---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";

const promotions = [
  { src: pro1, alt: "โปรโมชั่น ดีเฮง789 สมาชิกใหม่ ฝากทันทีรับเพิ่ม 50%" },
  { src: pro2, alt: "โปรโมชั่น ดีเฮง789 ยิ่งฝากเยอะ ยิ่งได้เยอะ คืนยอดเสียสูงสุด 10,000 บาท" },
  { src: pro3, alt: "โปรโมชั่น ดีเฮง789 นาทีทอง 07:00-09:00 รับเพิ่ม 20%" },
  { src: pro4, alt: "โปรโมชั่น ดีเฮง789 คืนยอดเสียสล็อตทุกวัน สูงสุด 0.8%" },
];
---

<MainLayout title="โปรโมชั่น ดีเฮง789 | โบนัสสล็อตสุดเฮง อัปเกรดทุนด้วย AI อัจฉริยะ" description="อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก ดีเฮง789 สล็อตสุดเฮงแตกง่าย กดรับโบนัสเครดิตฟรีเพื่อเพิ่มโอกาสสอยแจ็กพอตแตกหนัก ทำกำไรอย่างมั่นใจผ่านระบบ API แท้">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-amber-200 via-amber-400 to-red-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น ดีเฮง789</h1>

    <p class="mx-auto mb-10 max-w-3xl text-red-50/85">อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก ดีเฮง789 สล็อตสุดเฮงแตกง่าย กดรับโบนัสเครดิตฟรีเพื่ออัปเกรดเงินทุนตั้งต้น เพิ่มโอกาสสอยแจ็กพอตแตกหนักได้ต่อเนื่อง ทุกยอดถอนจ่ายจริงเต็ม 100% ผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์</p>

    <div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-6 px-4 sm:grid-cols-2">
      {
        promotions.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="mx-auto h-auto w-full rounded-xl border border-amber-500/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-[0_10px_20px_rgba(220,38,38,0.6)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-red-700 via-red-500 to-red-700 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(220,38,38,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
