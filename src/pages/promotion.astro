---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";

const promotions = [
  { src: pro1, alt: "โปรโมชั่น PORING168 คืนยอดเสีย 15% ตามรอบและเงื่อนไขที่เว็บไซต์กำหนด" },
  { src: pro2, alt: "โปรโมชั่น PORING168 ฝากแรกลุ้นรับทอง 1 บาท ตามเงื่อนไขที่เว็บไซต์กำหนด" },
  { src: pro3, alt: "โปรโมชั่น PORING168 แนะนำเพื่อน รับค่าคอมมิชชั่น 0.8% ตามเงื่อนไขที่เว็บไซต์กำหนด" },
];
---

<MainLayout
  title="PORING168 โปรโมชั่นสุดคุ้ม ยืดหยุ่น รับสิทธิ์ได้ทุกวัน"
  description="อัปเดตโปรโมชั่นที่ดีที่สุดจาก PORING168 มอบโบนัสและสิทธิพิเศษที่ยืดหยุ่น ปรับเปลี่ยนให้เข้ากับทุกสไตล์การใช้งาน รับสิทธิ์ง่ายผ่านระบบออโต้ คุ้มค่าที่สุด">
  <Announcement />

  <ContentBox title="PORING168 โปรโมชั่นสุดคุ้ม ยืดหยุ่น รับสิทธิ์ได้ทุกวัน">
    <p class="mb-10 text-left text-base leading-relaxed">
      PORING168 อัปเดตโบนัสและสิทธิพิเศษที่ออกแบบมาให้ยืดหยุ่น ปรับเปลี่ยนได้ตามสไตล์การใช้งานของแต่ละคน ทั้งสิทธิ์คืนยอดเสียตามรอบ โบนัสฝากแรก และรางวัลจากการแนะนำเพื่อน
      ทุกรายการรับสิทธิ์ได้ง่ายผ่านระบบออโต้ที่ประมวลผลในเสี้ยววินาที สอดรับกับนโยบายฝากถอนแบบไม่มีขั้นต่ำ ทำให้คุณเลือกใช้โปรที่เหมาะกับเป้าหมายของตัวเองได้อย่างอิสระ
      ทั้งนี้แต่ละรายการมีอัตรา ยอดสูงสุด และเกมที่ร่วมรายการต่างกัน แนะนำให้อ่านรายละเอียดและข้อกำหนดการถอนของโปรที่เลือกให้ครบถ้วนก่อนรับสิทธิ์ทุกครั้ง
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        promotions.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            class="mx-auto h-auto w-full rounded-xl border border-amber-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-[0_10px_20px_rgba(251,191,36,0.5)]"
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={80}
          />
        ))
      }
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 px-10 py-3.5 text-lg font-black text-[#04102e] shadow-[0_0_20px_rgba(251,191,36,0.6)] transition-transform hover:scale-105">
        ดูเงื่อนไขและสมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
