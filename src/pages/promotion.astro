---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
---

<MainLayout title="โปรโมชั่น NOVA852 | โบนัสเครดิตฟรี อัปเกรดทุนด้วย AI อัจฉริยะ" description="อัปเดตแพ็กเกจโปรโมชั่นสุดคุ้มจาก NOVA852 เว็บพนันออนไลน์ค่ายดัง กดรับโบนัสเครดิตฟรีเพื่อเพิ่มโอกาสสอยแจ็กพอตแตกง่าย ทำกำไรอย่างมั่นใจผ่านระบบ API แท้">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-slate-100 via-slate-300 to-amber-400 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น NOVA852</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3">
      <Picture
        src={pro1}
        alt="โปรโมชั่น NOVA852 รับโบนัสเครดิตฟรีสำหรับสมาชิกใหม่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น NOVA852 นาทีทอง 07:00-09:00 รับเพิ่ม 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น NOVA852 ยิ่งฝากเยอะยิ่งได้เยอะ คืนยอดเสียสูงสุด 10,000"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#eab308]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#eab308] hover:shadow-[0_10px_20px_rgba(234,179,8,0.8)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-amber-700 to-amber-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(234,179,8,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
