---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { id: 1, src: image1, name: "AskmeSlot", link: "/register" },
  { id: 2, src: image2, name: "Popular Game", link: "/register" },
  { id: 3, src: image3, name: "SlotXO", link: "/register" },
  { id: 4, src: image4, name: "Skywind Group", link: "/register" },
  { id: 5, src: image5, name: "PG Soft", link: "/register" },
  { id: 6, src: image6, name: "SBOBET", link: "/register" },
  { id: 7, src: image7, name: "Sexy Slot", link: "/register" },
  { id: 8, src: image8, name: "JILI", link: "/register" },
  { id: 9, src: image9, name: "Ask Me Bet", link: "/register" },
  { id: 10, src: image10, name: "New Game", link: "/register" },
  { id: 11, src: image11, name: "JOKER", link: "/register" },
  { id: 12, src: image12, name: "AFB Gaming", link: "/register" },
];
const homePage = Astro.url.origin;
const currentPath = Astro.url.pathname;
const pageTitle = "PORING168 ทดลองเล่นฟรี ค่ายเกมฮิต ลื่นไหล ไร้ข้อจำกัด";
const pageDescription =
  "โหมดทดลองเล่นฟรีบน PORING168 เปิดประสบการณ์ให้คุณสัมผัสระบบเกมที่ลื่นไหลและฟีเจอร์ระดับสากลได้อย่างอิสระ เรียนรู้จังหวะได้อย่างไร้ขีดจำกัด ไม่มีค่าใช้จ่าย";

const gameList = demoGames.map((game) => ({
  "@context": "https://schema.org",
  "@type": "Game",
  name: game.name,
  image: homePage + game.src.src,
  url: homePage + currentPath,
}));
---

<script type="application/ld+json" set:html={JSON.stringify(gameList)} />
<MainLayout title={pageTitle} description={pageDescription}>
  <Announcement />

  <ContentBox title="ทดลองเล่น PORING168 ศึกษาเกมสล็อตก่อนเริ่มใช้งานจริง">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-blue-50/85">
        โหมดทดลองเล่นของ PORING168 เปิดให้ศึกษากติกา ฟีเจอร์โบนัส และรูปแบบการจ่ายของเกมสล็อตแต่ละแนว ทั้งแบบคลาสสิก วิดีโอสล็อต เกมโบนัส และเกมที่มีฟีเจอร์พิเศษ ผู้เล่นสามารถเลือกดูเกมตามค่าย ธีม
        หรือระดับความผันผวนได้ง่าย เพื่อทำความคุ้นเคยกับจังหวะของเกมก่อนเริ่มใช้งานจริง ควรอ่านกติกาและตรวจสอบข้อมูลของแต่ละเกมประกอบด้วยทุกครั้ง แล้วเลือกเกมให้เหมาะกับงบประมาณและรูปแบบการเล่นของตนเอง
        รวมถึงตรวจสอบเงื่อนไขโปรโมชั่นว่าเกมที่สนใจเข้าร่วมรายการหรือไม่ก่อนรับสิทธิ์
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group relative flex flex-col gap-4 overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={`ทดลองเล่นเกมสล็อต ${game.name} ที่ PORING168`}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="mx-auto h-auto w-full max-w-[400px] object-cover shadow-xl transition-transform duration-300 group-hover:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href={game.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`ทดลองเล่น ${game.name}`}
                class="absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <span class="rounded-full bg-gradient-to-r from-amber-300 to-amber-500 px-6 py-2 font-bold text-[#04102e] shadow-[0_0_15px_rgba(251,191,36,0.55)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
