---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
---

<MainLayout
  title="ทางเข้าเล่น PGZEED168 | อัปเดตลิงก์ตรง ศูนย์สล็อต API แท้ แตกง่าย" description="รวมลิงก์ทางเข้าเล่น PGZEED168 อัปเดตใหม่ล่าสุด เข้าสู่แพลตฟอร์มคาสิโนออนไลน์ได้อย่างเสถียร รองรับสมาร์ทโฟนทุกระบบ ลื่นไหลไม่มีสะดุด มั่นใจทุกการลงทุน">
  <Announcement />

  <ContentBox title="ทางเข้าเล่น PGZEED168 อัปเดตลิงก์ตรงใหม่ล่าสุด">
    <p class="mb-8 text-left text-base leading-relaxed">
      รวมลิงก์ทางเข้าเล่น PGZEED168 อัปเดตใหม่ล่าสุด เข้าสู่แพลตฟอร์มคาสิโนออนไลน์ได้อย่างเสถียรทุกช่วงเวลา รองรับสมาร์ทโฟนทุกระบบทั้ง iOS และ Android เล่นผ่านเบราว์เซอร์ได้ทันทีโดยไม่ต้องโหลดแอป
      ลื่นไหลไม่มีสะดุดแม้ในชั่วโมงที่มีผู้เล่นหนาแน่น มั่นใจได้ทุกการลงทุนผ่านระบบ API แท้ที่ไม่มีการล็อคยูสเซอร์ พร้อมฝากถอนออโต้ด้วย AI อัจฉริยะ และการันตีจ่ายเต็ม 100%
    </p>

    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-lime-200 bg-gradient-to-b from-lime-300 to-lime-500 px-6 py-4 shadow-[0_0_20px_rgba(163,230,53,0.55),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(190,242,100,0.85)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-[#0a1a0e] drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-black tracking-wide text-[#0a1a0e]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-green-400 bg-gradient-to-b from-green-500 to-green-900 px-6 py-4 shadow-[0_0_20px_rgba(34,197,94,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(34,197,94,0.8)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-white drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-white [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
